---
import { photos } from '../../data/photos';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import QuoteRotator from '../../components/QuoteRotator.astro';
import SafetyNote from '../../components/SafetyNote.astro';
import IntroVideo from '../../components/IntroVideo.astro';
import ProgrammeCard from '../../components/ProgrammeCard.astro';
import { programmes } from '../../data/programmes';
import { approachStages, allCampaigns, campaignUrl, monthName } from '../../lib/content';

const campaigns = await allCampaigns();
const stageCampaign = (key: string) => campaigns.find((c) => c.data.stage === key);

const principles = [
  ['Nonviolence', 'No incitement, retaliation, humiliation or celebration of violence.'],
  ['Youth agency', 'Young people shape the agenda, create the content and lead safe actions.'],
  ['Inclusion', 'Every community, gender, ability, region, generation and location.'],
  ['Truth', 'Facts are sourced. Rumours are not amplified.'],
  ['Dignity', 'Victims, survivors and communities are shown with consent, care and respect.'],
  ['Non-partisanship', 'We endorse no party, candidate or armed actor, and hold everyone to the same standard.'],
  ['Do no harm', 'No public value justifies foreseeable harm to a person or community.'],
  ['Accountability', 'We correct errors, record complaints and report results honestly.'],
  ['Hope with action', 'Hope paired with practical responsibility, not slogans.'],
];

const messages = [
  'Peace is not someone else’s department; it is a daily public responsibility.',
  'Young people do not need to wait for a title before becoming peacebuilders.',
  'No community can build South Sudan alone, and no child is born carrying an inherited enemy.',
  'A gun may silence a disagreement, but it cannot create justice, trust or lasting security.',
  'Moving forward does not require forgetting; it requires truth, justice, healing and a refusal to create new wounds.',
  'Before forwarding a rumour, ask who may be harmed if it is false.',
  'Leadership is measured by the lives protected, the trust built and the conflicts prevented.',
  'We should inherit culture and wisdom, not enemies and unfinished revenge.',
];
---
<BaseLayout title="About us" description="Peace Across Generations is an independent, youth-led and non-partisan peacebuilding initiative for South Sudan. Our story, mission, vision, approach and principles.">
  <PageHead photo={photos.workshopDiscussion} title="About Peace Across Generations" eyebrow="Independent · Youth-led · Non-partisan">
    <p class="lede">Peace Across Generations is an independent, youth-led and non-partisan peacebuilding initiative connecting South Sudanese across communities, generations and borders to speak, listen, create and act for peace.</p>
  </PageHead>

  <nav class="container jump" aria-label="On this page">
    <ul>
      <li><a href="#story">Our story</a></li>
      <li><a href="#mission">Mission & vision</a></li>
      <li><a href="#approach">Our approach</a></li>
      <li><a href="#principles">What we believe</a></li>
      <li><a href="#programmes">Programmes</a></li>
      <li><a href="/about/team/">Our team</a></li>
    </ul>
  </nav>

  <section class="section section--surface" id="story" aria-labelledby="story-h">
    <div class="container story">
      <div>
        <h2 id="story-h">Our story</h2>
        <p>We use storytelling, letters, art, intergenerational dialogue, responsible digital communication and safe community action to make peaceful choices more visible in everyday life.</p>
        <p>Young people are at the centre. But elders, parents, teachers, faith and traditional leaders, artists, journalists, public leaders, the diaspora and friends of South Sudan all have a place here.</p>
        <p>Peace Across Generations continues the work of Foster Peace South Sudan, the founder’s earlier youth peace initiative. We carried forward what met today’s standards — school Peace Clubs, the 64 Voices idea and creative campaign materials — and refocused everything on safe, creative, intergenerational peacebuilding.</p>
        <p>On the International Day of Peace, 21 September 2026, we began <a href="/3000-days/">3,000 Days for Peace</a>: a promise to keep peace visible, practical and passed between generations until 7 December 2034.</p>
      </div>
      <IntroVideo />
    </div>
  </section>

  <section class="section" id="mission">
    <div class="container grid grid--2">
      <div class="card statement">
        <p class="eyebrow">Our mission</p>
        <p>To connect and mobilise South Sudanese inside the country and across the world to speak, listen, create and act for peace through inclusive storytelling, responsible media, intergenerational dialogue and practical local action.</p>
      </div>
      <div class="card statement">
        <p class="eyebrow">Our vision</p>
        <p>A peaceful South Sudan where every generation chooses dialogue, dignity and shared responsibility over violence, hatred and inherited division.</p>
      </div>
    </div>
  </section>

  <section class="section section--surface" id="approach" aria-labelledby="approach-h">
    <div class="container">
      <h2 id="approach-h">Our approach</h2>
      <p class="lede">Six stages — one for each campaign of our pilot season.</p>
      <ol class="stages">
        {approachStages.map((s) => {
          const c = stageCampaign(s.key);
          return (
            <li>
              <span class="stages__n">{s.n}</span>
              <strong class="stages__name">{s.name}</strong>
              {c && (c.data.draft
                ? <span class="stages__c">{monthName(c.data.month)}: {c.data.title}</span>
                : <a class="stages__c" href={campaignUrl(c)}>{monthName(c.data.month)}: {c.data.title}</a>)}
            </li>
          );
        })}
      </ol>
      <h3>How change happens</h3>
      <ol class="flow">
        {['Reach', 'Engage', 'Act', 'Connect', 'Learn', 'Sustain'].map((s) => <li><span>{s}</span></li>)}
      </ol>
      <p>We will not claim that social media or public messaging alone can end armed conflict. We measure the contribution we make to participation, dialogue, social cohesion, responsible information-sharing and safe community action.</p>
    </div>
  </section>

  <section class="section" id="principles" aria-labelledby="principles-h">
    <div class="container">
      <h2 id="principles-h">What we believe</h2>
      <ul class="grid grid--3 plain">
        {principles.map(([v, line]) => <li class="card"><h3>{v}</h3><p>{line}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="say">
    <div class="container">
      <h2 id="say">What we say</h2>
      <QuoteRotator quotes={messages} />
    </div>
  </section>

  <section class="section" id="programmes" aria-labelledby="programmes-h">
    <div class="container">
      <h2 id="programmes-h">Our programmes</h2>
      <p>Every month, all four programmes answer the same campaign — so one idea reaches you as a poem, a club session, an expert talk and an elder’s story.</p>
      <div class="grid grid--4">{programmes.map((p) => <ProgrammeCard {...p} />)}</div>
      <p class="more"><a class="text-link" href="/programmes/">How the programmes fit together →</a></p>
    </div>
  </section>

  <section class="section section--surface" id="independence">
    <div class="container narrow">
      <SafetyNote title="Our independence" variant="info">
        <p>Peace Across Generations is independent from any political party, candidate, armed actor, government institution or other organisation. We may work with public institutions, civil society, media, schools, traditional and faith leaders and partners when that work advances peace and does not compromise our independence, safety or editorial standards.</p>
        <ul>
          <li>No party, candidate or armed actor may use our name, logo, events or content as an endorsement.</li>
          <li>We disclose partnerships and sponsorships where relevant.</li>
          <li>During the pilot we are an initiative, not a registered NGO. We will say so honestly until that changes.</li>
        </ul>
      </SafetyNote>
    </div>
  </section>

  <section class="section" id="team">
    <div class="container narrow">
      <div class="card card--link team-teaser">
        <p class="eyebrow">Who we are</p>
        <h2><a class="card__link" href="/about/team/">Meet our team</a></h2>
        <p>An Executive Director and six functional leads, working as peers.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 860px; }
  .jump ul { list-style: none; padding: 1.5rem 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; }
  .jump li { margin: 0; }
  .jump a { display: inline-block; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); text-decoration: none; font-weight: 600; font-size: 0.92rem; }
  .story { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 960px) { .story { grid-template-columns: 1.1fr 1fr; } }
  .statement { border-top: 6px solid var(--color-green); }
  .statement p:last-child { font-family: var(--font-heading); font-weight: 600; color: var(--heading); font-size: 1.2rem; line-height: 1.4; }
  .stages { list-style: none; padding: 0; display: grid; gap: 0.75rem; margin-bottom: 2rem; }
  @media (min-width: 640px) { .stages { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .stages { grid-template-columns: repeat(3, 1fr); } }
  .stages li { margin: 0; max-width: none; background: var(--surface-alt); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.25rem; display: grid; gap: 0.2rem; }
  .stages__n { font-family: var(--font-heading); font-weight: 700; color: var(--color-sky); font-size: 1.6rem; line-height: 1; }
  .stages__name { font-family: var(--font-heading); font-size: 1.35rem; color: var(--heading); }
  .stages__c { font-size: 0.92rem; color: var(--text-muted); }
  a.stages__c { color: var(--link); }
  .plain { list-style: none; padding: 0; }
  .plain li { margin: 0; }
  .plain h3 { color: var(--accent-text); }
  .more { margin-top: 1.25rem; }
  .team-teaser { border-top: 6px solid var(--color-green); }
  .team-teaser h2 a { text-decoration: none; color: inherit; }
</style>
