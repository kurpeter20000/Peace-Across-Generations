---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Tbd from '../../components/Tbd.astro';
import { photos } from '../../data/photos';

// Roles appear only once filled in the content editor (name added, "Role still open" off).
const sorted = (await getCollection('team', ({ data }) => !data.open && !!data.name)).sort((a, b) => a.data.order - b.data.order);
const [founder, ...leads] = sorted;
---
<BaseLayout title="Our team" description="The people behind Peace Across Generations, and the roles still open for volunteers.">
  <PageHead photo={photos.founderSpeaking} title="Our team" eyebrow="About us" lede="An Executive Director and six functional leads, working as peers. Most of the work is online; peace club coordination is on the ground in South Sudan." />

  {founder && (
    <section class="section section--surface" aria-labelledby="founder-h">
      <div class="container">
        <h2 id="founder-h" class="visually-hidden">Founder</h2>
        <article class="card founder-card">
          <div class="founder-card__photo">
            {founder.data.photo ? <Picture class="ld-hide" src={founder.data.photo} alt={founder.data.name ?? ''} widths={[320, 480]} sizes="(min-width: 760px) 280px, 100vw" formats={['avif', 'webp']} loading="eager" /> : <Tbd>photo</Tbd>}
          </div>
          <div class="founder-card__body">
            <p class="eyebrow">{founder.data.role}</p>
            <h3>{founder.data.name}</h3>
            {founder.data.bio ? <p>{founder.data.bio}</p> : <p><Tbd>bio, 60–80 words</Tbd></p>}
          </div>
        </article>
      </div>
    </section>
  )}

  {leads.length > 0 && (
    <section class="section" aria-labelledby="team-h">
      <div class="container">
        <h2 id="team-h">Our leads</h2>
        <ul class="grid grid--3 plain">
          {leads.map(({ data: m }) => (
            <li class="card member">
              <p class="eyebrow">{m.role}</p>
              <h3>{m.name}</h3>
              {m.photo ? <Picture class="ld-hide team-photo" src={m.photo} alt={m.name ?? ''} widths={[160, 320]} sizes="160px" formats={['avif', 'webp']} width={160} height={160} /> : <p><Tbd>photo</Tbd></p>}
              {m.bio ? <p>{m.bio}</p> : <p><Tbd>bio, 60–80 words</Tbd></p>}
              {m.owns && <p class="owns"><strong>Leads on:</strong> {m.owns}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <section class="section">
    <div class="container narrow">
      <div class="note">
        <p><strong>Want to help?</strong> Volunteers support every part of our work. Every volunteer signs our code of conduct.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/take-action/volunteer/">Volunteer with us</a>
          <a class="btn btn--secondary" href="/about/">About Peace Across Generations</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 860px; }
  .plain { list-style: none; padding: 0; }
  .plain li { margin: 0; }
  .owns { font-size: 0.92rem; color: var(--text-muted); }
  :global(.team-photo) { border-radius: 50%; margin-bottom: 0.75rem; width: 140px; height: 140px; object-fit: cover; }

  .founder-card { display: flex; flex-wrap: wrap; gap: 0; overflow: hidden; padding: 0; border-top: none; }
  .founder-card__photo { flex: 1 1 240px; min-width: 0; }
  .founder-card__photo :global(img) { display: block; width: 100%; height: 100%; min-height: 280px; object-fit: cover; }
  .founder-card__body { flex: 1 1 320px; padding: 2rem; display: flex; flex-direction: column; justify-content: center; gap: 0.5rem; }
  .founder-card h3 { font-size: 1.8rem; }
</style>
