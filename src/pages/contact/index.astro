---
import { photos } from '../../data/photos';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Email from '../../components/Email.astro';
import Tbd from '../../components/Tbd.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import EnquiryForm from '../../components/EnquiryForm.astro';

const labels = { facebook: 'Facebook', instagram: 'Instagram', youtube: 'YouTube', linkedin: 'LinkedIn', tiktok: 'TikTok', x: 'X' } as const;
const socials = Object.entries(site.socials) as [keyof typeof labels, string | null][];
const live = socials.filter(([, url]) => url);
---
<BaseLayout title="Contact us" description="Email Peace Across Generations. Based in South Sudan, working with South Sudanese everywhere.">
  <PageHead photo={photos.founderListening} title="Contact us" lede="Based in South Sudan, working with South Sudanese everywhere." />

  <section class="section">
    <div class="container contact-split">
      <div class="contact-ways">
        <ul class="contact-cards">
          <li>
            {site.whatsapp ? (
              <a class="contact-card" href={`https://wa.me/${String(site.whatsapp).replace(/\D/g, '')}`} rel="noopener">
                <span class="icon-badge"><Icon name="whatsapp" /></span>
                <span><strong>WhatsApp</strong><span>{String(site.whatsapp).replace(/^\+?(\d{3})(\d{3})(\d{3})(\d{3})$/, '+$1 $2 $3 $4')} · also for submissions</span></span>
              </a>
            ) : (
              <div class="contact-card contact-card--static">
                <span class="icon-badge"><Icon name="whatsapp" /></span>
                <span><strong>WhatsApp</strong><span><Tbd>number</Tbd> · also for submissions</span></span>
              </div>
            )}
          </li>
          <li>
            <div class="contact-card contact-card--static">
              <span class="icon-badge contact-card__icon--alt"><Icon name="mail" /></span>
              <span><strong>Email</strong><span><Email /></span></span>
            </div>
          </li>
        </ul>
        {live.length > 0 && (
          <div class="follow">
            <p class="eyebrow">Follow us</p>
            {live.map(([k, url]) => <a class="social" href={url!} rel="noopener">{labels[k]}</a>)}
          </div>
        )}
        <ul class="quick">
          <li><a href="/take-action/share-your-voice/">Share your voice</a></li>
          <li><a href="/schools-and-communities/">Host a club</a></li>
          <li><a href="/take-action/partner/#speak">Speak at Peace Talks</a></li>
          <li><a href="/take-action/volunteer/">Volunteer</a></li>
          <li><Email label="Media enquiries" subject="Media enquiry" /></li>
        </ul>
      </div>
      <div id="form" class="contact-form">
        <h2>Send us a message</h2>
        <EnquiryForm type="contact" submitLabel="Send message" messageLabel="Your message" />
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="concern-band">
        <div>
          <p class="eyebrow">Report a concern</p>
          <h2>Worried about safety, harm or misuse of our name?</h2>
          <p>Tell us confidentially. If anyone is in immediate danger, contact local emergency services first.</p>
        </div>
        <a class="btn btn--light" href="/report-a-concern/">Report a concern</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-split { display: grid; gap: 2.5rem; align-items: start; }
  .contact-split > * { min-width: 0; }
  @media (min-width: 900px) { .contact-split { grid-template-columns: 1fr 1.2fr; } }
  .contact-cards { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.75rem; }
  .contact-cards li { margin: 0; }
  .contact-card {
    display: flex; gap: 0.9rem; align-items: center; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 1rem 1.2rem; text-decoration: none; color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.contact-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); text-decoration: none; }
  .contact-card strong { display: block; font-family: var(--font-heading); color: var(--heading); }
  .contact-card .icon-badge { margin: 0; background: var(--color-olive-tint); color: var(--color-olive); }
  .contact-card__icon--alt { background: var(--color-terracotta-tint); color: var(--color-terracotta); }
  .follow { margin-bottom: 1.5rem; }
  .social { margin-right: 1rem; font-weight: 600; }
  .quick { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .quick li { margin: 0; }
  .quick a { display: inline-block; padding: 0.45rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-pill); background: var(--surface); font-weight: 600; font-size: 0.92rem; text-decoration: none; }
  .contact-form h2 { font-size: 1.3rem; }
  .concern-band {
    background: var(--color-navy); color: #fff; border-radius: var(--radius);
    padding: clamp(1.75rem, 1.4rem + 1.5vw, 2.75rem); display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between;
  }
  .concern-band h2, .concern-band .eyebrow { color: #fff; }
  .concern-band .eyebrow { color: var(--color-sun); }
  .concern-band p { color: var(--color-ink-muted); max-width: 42ch; }
</style>
