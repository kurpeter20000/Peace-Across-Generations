---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CampaignPage from '../../components/CampaignPage.astro';
import { publishedThemes, currentTheme, type Theme } from '../../lib/content';

export async function getStaticPaths() {
  const themes = await publishedThemes();
  return themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}

const { theme } = Astro.props as { theme: Theme };
const current = await currentTheme();
---
<BaseLayout title={`${theme.data.title} — campaign`} description={theme.data.message ?? theme.data.intro}>
  <CampaignPage theme={theme} isCurrent={current?.id === theme.id} />
</BaseLayout>
