---
// Content from the PAG Programme Portfolio 2026–2027, section 6.
import { photos } from '../../data/photos';
import site from '../../data/site.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import OnThisPage from '../../components/programme/OnThisPage.astro';
import ContributeCards from '../../components/programme/ContributeCards.astro';
import ProgrammeGallery from '../../components/programme/ProgrammeGallery.astro';

const wa = `https://wa.me/${String(site.whatsapp).replace(/\D/g, '')}`;

const pauseMonths = [
  ['October', 'The three-question sharing habit'],
  ['November', 'Rumours that trigger revenge: check before reacting'],
  ['December', 'Manipulated images and political content'],
  ['January', 'Never share images of victims'],
  ['February', 'Which habits have stuck'],
];
---
<BaseLayout title="Running threads" description="Peace in 90 Seconds, Pause Before You Share, Peace Where We Live, and 64 Voices, One Future — four threads that run through every programme.">
  <PageHead photo={photos.peaceWatercolour} title="Running through everything" eyebrow="Four running threads" lede="Four threads appear inside every programme. They are not separate programmes and need no extra team — they keep our work consistent, practical and fair." />

  <OnThisPage links={[['#overview', 'Overview'], ['#90-seconds', 'Peace in 90 Seconds'], ['#pause', 'Pause Before You Share'], ['#where-we-live', 'Peace Where We Live'], ['#64-voices', '64 Voices, One Future'], ['#contribute', 'Get involved']]} />

  <section class="section" id="overview" aria-labelledby="ov-h">
    <div class="container">
      <div class="section-title">
        <p class="eyebrow">At a glance</p>
        <h2 id="ov-h">How the threads run</h2>
      </div>
      <div class="table-wrap">
        <table class="table-cards">
          <thead><tr><th scope="col">Thread</th><th scope="col">What it is</th><th scope="col">Rhythm</th></tr></thead>
          <tbody>
            <tr><td><a href="#90-seconds">Peace in 90 Seconds</a></td><td data-label="What it is">Founder and expert explainers: one idea, one source, one action</td><td data-label="Rhythm">1–2 a week, opening each week’s theme — 32 across the pilot</td></tr>
            <tr><td><a href="#pause">Pause Before You Share</a></td><td data-label="What it is">Digital responsibility: rumour checks, a simple sharing habit, and pointers to South Sudanese fact-checkers</td><td data-label="Rhythm">At least one focused action a month</td></tr>
            <tr><td><a href="#where-we-live">Peace Where We Live</a></td><td data-label="What it is">One small offline action every weekend</td><td data-label="Rhythm">A weekly prompt; clubs and circles report what they did</td></tr>
            <tr><td><a href="#64-voices">64 Voices, One Future</a></td><td data-label="What it is">A representation standard: which communities are being heard, and which are missing</td><td data-label="Rhythm">Reviewed monthly across all programmes</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section band-off" id="90-seconds" aria-labelledby="t1-h">
    <div class="container two-col">
      <div>
        <span class="icon-badge"><Icon name="sun" /></span>
        <h2 id="t1-h">Peace in 90 Seconds</h2>
        <p>Short explainers from our founder and invited experts. Each one carries <strong>one idea, one source and one action</strong> — small enough to watch on a slow connection and forward on WhatsApp.</p>
        <p>They open each week’s theme, so the same idea then appears in the week’s letters, club sessions, talks and episodes. Across the pilot we aim to publish 32.</p>
        <a class="btn btn--primary btn--arrow" href="/stories/videos/">Watch the explainers</a>
      </div>
      <ul class="tiles">
        <li><h3>One idea</h3><p>A single, clear point about peace, dialogue or responsibility.</p></li>
        <li><h3>One source</h3><p>Where the idea or fact comes from, so you can check it.</p></li>
        <li><h3>One action</h3><p>Something you can do this week, wherever you live.</p></li>
      </ul>
    </div>
  </section>

  <section class="section" id="pause" aria-labelledby="t2-h">
    <div class="container two-col">
      <div>
        <span class="icon-badge"><Icon name="search" /></span>
        <h2 id="t2-h">Pause Before You Share</h2>
        <p>One habit, practised every month. Before you forward anything, ask three questions:</p>
        <ol class="three-q">
          <li>Who made this?</li>
          <li>Who gains if I share it?</li>
          <li>Who gets hurt if it is false?</li>
        </ol>
        <p>When you correct a rumour, <strong>lead with the truth</strong> — and avoid repeating the false claim in a way that spreads it further.</p>
        <p class="note-small">We would rather point people to established South Sudanese fact-checking efforts, such as #defyhatenow and 211Check, than build a verification operation of our own. We are not partnered with them.</p>
        <a class="btn btn--secondary btn--arrow" href="/pause-before-you-share/">Learn the habit</a>
      </div>
      <div>
        <h3>Monthly focus during the pilot</h3>
        <div class="table-wrap">
          <table class="table-cards">
            <thead><tr><th scope="col">Month</th><th scope="col">Focus</th></tr></thead>
            <tbody>{pauseMonths.map(([m, f]) => <tr><td>{m}</td><td data-label="Focus">{f}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-off" id="where-we-live" aria-labelledby="t3-h">
    <div class="container two-col">
      <div>
        <span class="icon-badge"><Icon name="sprout" /></span>
        <h2 id="t3-h">Peace Where We Live</h2>
        <p>One small offline action every weekend — small enough for anyone to do within the week, wherever they live. We share a prompt each week; clubs and circles report back what they did.</p>
        <p>Our pilot aims to document <strong>24 actions</strong>, shared with permission.</p>
        <a class="btn btn--primary btn--arrow" href={wa} rel="noopener">Tell us what you did</a>
      </div>
      <div>
        <h3>Examples of weekend actions</h3>
        <ul class="ticks">
          <li>Read a Letter for Peace aloud at dinner.</li>
          <li>Ask an elder one question about how people lived together.</li>
          <li>Greet someone from another community in their language.</li>
          <li>Kindly correct one rumour.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="64-voices" aria-labelledby="t4-h">
    <div class="container two-col">
      <div>
        <span class="icon-badge"><Icon name="users" /></span>
        <h2 id="t4-h">64 Voices, One Future</h2>
        <p>South Sudan is home to many communities. The figure 64 is widely cited, but it is not an official count. This thread is a way of working, not a checklist: each month we look across all our programmes at which communities are being heard — and which are missing.</p>
        <p>It also has a flagship series inside <a href="/programmes/generations-in-conversation/">Generations in Conversation</a>, where every episode ends with the same question: <em>What should our children inherit — and what should end with us?</em></p>
      </div>
      <div>
        <h3>Our rules</h3>
        <ul class="ticks">
          <li>Contributors choose whether to name their community.</li>
          <li>Titles and headlines never lead with tribal labels.</li>
          <li>There is no quota — we hear from communities steadily and honestly.</li>
          <li>We will never claim to have heard from every community.</li>
        </ul>
      </div>
    </div>
  </section>

  <ProgrammeGallery
    eyebrow="Unity in diversity"
    photos={[photos.unityInDiversity, photos.noWarFence]}
    caption="64 Voices is a standard we hold ourselves to across every programme — and a message we hope spreads further than our own work."
  />

  <ContributeCards
    roles={[
      { who: 'Experts and practitioners', what: 'Record a Peace in 90 Seconds explainer: one idea, one source, one action.', href: '/take-action/partner/#speak', cta: 'Offer an explainer', icon: 'mic' },
      { who: 'Everyone', what: 'Seen a rumour that could cause harm? Send it to us rather than forwarding it.', href: wa, cta: 'Send a rumour', icon: 'search', external: true },
      { who: 'Families, clubs and circles', what: 'Do this week’s Peace Where We Live action and tell us what happened.', href: wa, cta: 'Share your action', icon: 'sprout', external: true },
      { who: 'Voices from every community', what: 'Help us hear from communities we have not yet reached — share your story in your own language.', href: '/take-action/share-your-voice/', cta: 'Share your voice', icon: 'users' },
    ]}
  />
</BaseLayout>

<style>
  .three-q { font-family: var(--font-heading); font-weight: 700; color: var(--heading); font-size: 1.15rem; padding-left: 1.4rem; }
  .three-q li { margin-bottom: 0.4rem; }
  .icon-badge { margin-bottom: 0.75rem; }
</style>
