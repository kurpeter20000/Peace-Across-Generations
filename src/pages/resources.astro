---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ResourceCard from '../components/ResourceCard.astro';

const order = ['guide', 'toolkit', 'video', 'article', 'research', 'book', 'podcast'] as const;
const labels = { guide: 'Guides', toolkit: 'Toolkits', video: 'Videos', article: 'Articles', research: 'Research', book: 'Books', podcast: 'Podcasts' };
const resources = (await getCollection('resources', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title),
);
const groups = order.map((type) => ({ type, items: resources.filter((r) => r.data.type === type) })).filter((g) => g.items.length);
---
<BaseLayout title="Resources" description="Guides, toolkits, videos, articles and research for peacebuilding in South Sudan — chosen and checked by Peace Across Generations.">
  <PageHead title="Resources" lede="Guides, toolkits, videos, articles and research for everyday peacebuilding. We only list resources we have checked." />

  {groups.length > 1 && (
    <nav class="container jump" aria-label="Resource types">
      <ul>{groups.map((g) => <li><a href={`#${g.type}`}>{labels[g.type]}</a></li>)}</ul>
    </nav>
  )}

  {groups.map((g, i) => (
    <section class:list={['section', { 'section--surface': i % 2 === 0 }]} id={g.type} aria-labelledby={`${g.type}-h`}>
      <div class="container">
        <h2 id={`${g.type}-h`}>{labels[g.type]}</h2>
        <div class="grid grid--3">{g.items.map((r) => <ResourceCard resource={r} />)}</div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container narrow">
      <div class="note">
        <p><strong>Know a resource that helped your community?</strong> Suggest it — a guide, a study, a book or a video. We check every suggestion before listing it.</p>
        <a class="btn btn--secondary" href="/contact/#form">Suggest a resource</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 820px; }
  .jump ul { list-style: none; padding: 0 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; }
  .jump li { margin: 0; }
  .jump a { display: inline-block; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); text-decoration: none; font-weight: 600; font-size: 0.92rem; }
</style>
