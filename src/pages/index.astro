---
import BaseLayout from '../layouts/BaseLayout.astro';
import DayCounter from '../components/DayCounter.astro';
import StoryList from '../components/StoryList.astro';
import LeafDivider from '../components/LeafDivider.astro';
import Icon from '../components/Icon.astro';
import IntroVideo from '../components/IntroVideo.astro';
import PostCard from '../components/PostCard.astro';
import QuoteCard from '../components/QuoteCard.astro';
import TakeActionCards from '../components/TakeActionCards.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { currentTheme, weeklyAction, publishedStories, publishedPosts, monthName, campaignUrl, approachStages } from '../lib/content';

const theme = await currentTheme();
const action = weeklyAction(theme);
const stories = await publishedStories();
const featured = stories.filter((s) => s.data.featured).slice(0, 3);
const latest = stories.slice(0, 3);
const posts = (await publishedPosts()).slice(0, 3);
const stage = approachStages.find((s) => s.key === theme?.data.stage);

const beliefs = [
  { icon: 'leaf', text: 'Peace is more than the absence of violence.' },
  { icon: 'generations', text: 'Every generation matters.' },
  { icon: 'message', text: 'Dialogue matters.' },
  { icon: 'book', text: 'Stories can change perspectives.' },
  { icon: 'hand', text: 'Peace is everyone’s responsibility.' },
  { icon: 'sprout', text: 'We choose what we pass on.' },
] as const;

const promises = [
  { icon: 'scale', title: 'Non-partisan.', text: 'We endorse no party, candidate or armed actor.' },
  { icon: 'shield', title: 'Safe.', text: 'Nothing is published without consent and review.' },
  { icon: 'check', title: 'Factual.', text: 'We cite sources and correct mistakes publicly.' },
  { icon: 'heart', title: 'Respectful.', text: 'We never blame a whole community.' },
] as const;
---
<BaseLayout>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Independent · Youth-led · Non-partisan</p>
        <h1>Every generation inherits something. We can decide what we pass on.</h1>
        <p class="lede">Peace Across Generations is an independent, youth-led and non-partisan peacebuilding initiative connecting South Sudanese across communities, generations and borders to speak, listen, create and act for peace.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/campaigns/current/" data-track="cta:join-hero">Join the conversation</a>
          <a class="btn btn--secondary" href="/take-action/share-your-voice/" data-track="cta:share-hero">Share your voice</a>
        </div>
        <p class="hero-day"><Icon name="sun" /><DayCounter /></p>
      </div>
      <div class="hero__media">
        <IntroVideo />
      </div>
    </div>
  </section>

  <!-- 2. Why we exist -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Why we exist</p>
      <h2>Why Peace Cannot Wait</h2>
      <p class="lede">South Sudan’s young people are too often recruited, displaced or left out of decisions. They are also students, creators, entrepreneurs and organisers — the builders of everyday peace.</p>
      <p>Social media is our entry point, not our destination. We succeed when a post becomes a conversation, a conversation becomes an action, and an action becomes a peaceful habit.</p>
      <a class="text-link" href="/about/">Our story →</a>
    </div>
  </section>

  <!-- 3. What we believe -->
  <section class="section section--surface" aria-labelledby="believe">
    <div class="container">
      <h2 id="believe">What we believe</h2>
      <LeafDivider align="left" />
      <ul class="beliefs">
        {beliefs.map((b) => (
          <li><span class="icon-badge"><Icon name={b.icon} /></span><p>{b.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Featured campaign -->
  {theme && (
    <section class="section" aria-labelledby="campaign">
      <div class="container">
        <div class="campaign">
          <div>
            <p class="eyebrow">Featured campaign · {monthName(theme.data.month)}{stage && ` · ${stage.n} ${stage.name}`}</p>
            <h2 id="campaign">{theme.data.title}</h2>
            <p class="campaign__msg">{theme.data.message ?? theme.data.creativePrompt}</p>
            {theme.data.contributionTypes.length > 0 && (
              <ul class="chips" aria-label="Ways to contribute">{theme.data.contributionTypes.map((c) => <li>{c}</li>)}</ul>
            )}
            <div class="btn-row">
              <a class="btn btn--primary" href={campaignUrl(theme)} data-track="cta:join-campaign">Join the conversation</a>
              <a class="btn btn--secondary" href="/take-action/share-your-voice/" data-track="cta:share-campaign">Share your voice</a>
            </div>
          </div>
          {action && (
            <aside class="weekly">
              <span class="icon-badge"><Icon name="sprout" /></span>
              <p class="eyebrow">Peace Where We Live</p>
              <p><strong>This weekend:</strong> {action.action}</p>
            </aside>
          )}
        </div>
        <p class="more"><a class="text-link" href="/campaigns/">All campaigns →</a></p>
      </div>
    </section>
  )}

  <!-- 5. Featured voices -->
  {featured.length > 0 && (
    <section class="section section--surface" aria-labelledby="voices">
      <div class="container">
        <h2 id="voices">Featured voices</h2>
        <div class="grid grid--3">{featured.map((s) => <QuoteCard story={s} />)}</div>
      </div>
    </section>
  )}

  <!-- 6. Latest stories -->
  <section class:list={['section', { 'section--surface': featured.length === 0 }]} aria-labelledby="latest">
    <div class="container">
      <h2 id="latest">Latest stories</h2>
      <StoryList stories={latest} />
      {latest.length > 0 && <p class="more"><a class="text-link" href="/stories/">All stories & voices →</a></p>}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="blog">
      <div class="container">
        <p class="eyebrow">Blog</p>
        <h2 id="blog">Progress for peace</h2>
        <div class="grid grid--3">{posts.map((p) => <PostCard post={p} />)}</div>
        <p class="more"><a class="text-link" href="/blog/">More from the blog →</a></p>
      </div>
    </section>
  )}

  <!-- 7. Take action -->
  <section class="section" aria-labelledby="act">
    <div class="container">
      <p class="eyebrow">Take action</p>
      <h2 id="act">You don’t need money, a title or perfect English.</h2>
      <p class="lede">If you have a phone, a pen or a voice, there is a place for you here. The first 100 contributors will be recognised as <strong>Founding Creators</strong>.</p>
      <TakeActionCards />
    </div>
  </section>

  <!-- 3,000-day promise -->
  <section class="section band">
    <div class="container narrow">
      <h2>3,000 days. One promise.</h2>
      <p>From the International Day of Peace, 21 September 2026, to 7 December 2034, we commit to keeping peace visible, practical and passed between generations — before, during and after moments of crisis.</p>
      <a class="btn btn--secondary" href="/3000-days/">Read the commitment</a>
    </div>
  </section>

  <!-- Our promise -->
  <section class="section section--tight section--surface" aria-label="Our promise to you">
    <div class="container">
      <ul class="promises">
        {promises.map((p) => <li><Icon name={p.icon} /><span><strong>{p.title}</strong> {p.text}</span></li>)}
      </ul>
      <p class="promises__more"><a class="text-link" href="/standards/">Read our standards →</a></p>
    </div>
  </section>

  <!-- 8. Newsletter -->
  <section class="section" aria-labelledby="news">
    <div class="container narrow newsletter-block">
      <h2 id="news">Stay in the conversation</h2>
      <p>One short email a month: the new campaign, voices worth hearing and ways to take part.</p>
      <NewsletterForm source="home" id="newsletter-home" />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 820px; }
  .hero__grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .hero h1 { font-size: clamp(2rem, 1.3rem + 3.2vw, 3.3rem); }
  .hero__media :global(.eyebrow) { display: none; }
  .hero-day { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; color: var(--heading); }
  .hero-day :global(svg) { width: 22px; height: 22px; color: var(--color-leaf); }

  .beliefs { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .beliefs { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .beliefs { grid-template-columns: repeat(3, 1fr); } }
  .beliefs li {
    margin: 0; max-width: none; display: flex; gap: 1rem; align-items: center;
    background: var(--surface-alt); border-radius: var(--radius); padding: 1.1rem 1.25rem; border: 1px solid var(--line);
  }
  .beliefs .icon-badge { margin: 0; flex: none; background: var(--surface); }
  .beliefs p { margin: 0; font-family: var(--font-heading); font-weight: 600; color: var(--heading); font-size: 1.08rem; line-height: 1.35; }

  .campaign {
    display: grid; gap: 1.5rem; background: var(--surface); border: 1px solid var(--line); border-top: 6px solid var(--color-green);
    border-radius: var(--radius); padding: clamp(1.35rem, 1rem + 2vw, 2.5rem); box-shadow: var(--shadow);
  }
  @media (min-width: 900px) { .campaign { grid-template-columns: 1.6fr 1fr; align-items: start; } }
  .campaign h2 { font-size: clamp(1.7rem, 1.2rem + 2vw, 2.6rem); }
  .campaign__msg { font-size: 1.2rem; max-width: 52ch; }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips li { margin: 0; background: var(--color-sand); color: var(--color-navy); border-radius: 999px; padding: 0.3rem 0.8rem; font-size: 0.88rem; font-weight: 600; }
  @media (prefers-color-scheme: dark) { .chips li { background: #0f1d31; color: #e6edf5; } }
  .weekly { background: var(--surface-alt); border-radius: var(--radius); padding: 1.25rem; border-left: 5px solid var(--color-leaf); }
  .weekly .eyebrow { display: block; margin: 0.25rem 0; }
  .weekly p:last-child { margin: 0; font-size: 1.08rem; }
  .more { margin-top: 1.25rem; }

  .promises { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem 1.5rem; }
  @media (min-width: 700px) { .promises { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .promises { grid-template-columns: repeat(4, 1fr); } }
  .promises li { margin: 0; display: flex; gap: 0.6rem; align-items: flex-start; max-width: none; font-size: 0.98rem; }
  .promises :global(svg) { width: 22px; height: 22px; flex: none; color: var(--accent-text); margin-top: 0.15rem; }
  .promises__more { margin: 1rem 0 0; }
  .newsletter-block { text-align: left; }
</style>
