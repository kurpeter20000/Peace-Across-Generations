---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import DayCounter from '../components/DayCounter.astro';
import ThemeBanner from '../components/ThemeBanner.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import StoryList from '../components/StoryList.astro';
import LeafDivider from '../components/LeafDivider.astro';
import Icon from '../components/Icon.astro';
import { programmes } from '../data/programmes';
import { currentTheme, weeklyAction, publishedStories } from '../lib/content';

const theme = await currentTheme();
const action = weeklyAction(theme);
const latest = (await publishedStories()).slice(0, 3);

const promises = [
  { icon: 'scale', title: 'Non-partisan.', text: 'We endorse no party, candidate or armed actor.' },
  { icon: 'shield', title: 'Safe.', text: 'Every published piece has consent. Children need a guardian’s consent too.' },
  { icon: 'check', title: 'Factual.', text: 'We cite sources and correct our mistakes publicly.' },
  { icon: 'heart', title: 'Respectful.', text: 'We never blame a whole community.' },
] as const;
---
<BaseLayout>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container split">
      <div>
        <h1>Every Voice. Every Generation. One Peace.</h1>
        <p class="lede">An independent, youth-led movement connecting South Sudanese across communities, generations and borders to speak, listen, create and act for peace.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/take-part/">Take part this month</a>
          <a class="btn btn--secondary" href="/programmes/generations-in-conversation/"><Icon name="headphones" />Listen to the conversations</a>
        </div>
        <p class="hero-day"><Icon name="sun" /><DayCounter /></p>
      </div>
      <HeroArt />
    </div>
  </section>

  <!-- 2. This month's theme -->
  <section class="section">
    <div class="container">
      <ThemeBanner theme={theme} />
    </div>
  </section>

  <!-- 3. Why we exist -->
  <section class="section section--surface">
    <div class="container narrow">
      <p class="eyebrow">Why we exist</p>
      <h2>Peace cannot wait for someone else.</h2>
      <p>South Sudan’s young people are too often recruited, displaced or left out of decisions. They are also students, creators, entrepreneurs and organisers — the builders of everyday peace.</p>
      <p>Social media is our entry point, not our destination. We succeed when a post becomes a conversation, a conversation becomes an action, and an action becomes a peaceful habit.</p>
    </div>
  </section>

  <!-- 4. Four ways in -->
  <section class="section" aria-labelledby="ways-in">
    <div class="container">
      <p class="eyebrow">Our programmes</p>
      <h2 id="ways-in">Four ways in</h2>
      <div class="grid grid--4">
        {programmes.map((p) => <ProgrammeCard {...p} />)}
      </div>
      <p class="under-cards">Every month, all four programmes answer the same theme — so one idea reaches you as a poem, a club session, an expert talk and an elder’s story.</p>
    </div>
  </section>

  <!-- 5. Latest stories -->
  <section class="section section--surface" aria-labelledby="latest">
    <div class="container">
      <h2 id="latest">Latest stories</h2>
      <StoryList stories={latest} />
      {latest.length > 0 && <p class="more"><a class="text-link" href="/stories/">All stories →</a></p>}
    </div>
  </section>

  <!-- 6. Everyone has an entry point -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Everyone has an entry point</p>
      <h2>You don’t need money, a title or perfect English.</h2>
      <p>A phone video. A handwritten letter. A voice note. A drawing, a poem, a song, a translation, an interview with your grandmother. If you have a phone, a pen or a voice, you can take part this month.</p>
      <p>The first 100 contributors will be recognised as <strong>Founding Creators</strong> — a status no one who joins later can have.</p>
      <a class="btn btn--primary" href="/take-part/">Take part</a>
    </div>
  </section>

  <!-- 7. This week's small action -->
  {action && (
    <section class="section section--tight">
      <div class="container">
        <div class="weekly">
          <span class="icon-badge"><Icon name="sprout" /></span>
          <div>
            <p class="eyebrow">Peace Where We Live</p>
            <p class="weekly__text"><strong>This weekend:</strong> {action.action}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 8. The 3,000-day promise -->
  <section class="section band">
    <div class="container narrow">
      <h2>3,000 days. One promise.</h2>
      <p>From the International Day of Peace, 21 September 2026, to 7 December 2034, we commit to keeping peace visible, practical and passed between generations — before, during and after moments of crisis.</p>
      <a class="btn btn--secondary" href="/3000-days/">Read the commitment</a>
    </div>
  </section>

  <!-- 9. Our promise to you -->
  <section class="section section--surface" aria-labelledby="promise">
    <div class="container">
      <h2 id="promise">Our promise to you</h2>
      <LeafDivider align="left" />
      <ul class="grid grid--4 promises">
        {promises.map((p) => (
          <li class="card">
            <span class="icon-badge"><Icon name={p.icon} /></span>
            <p><strong>{p.title}</strong> {p.text}</p>
          </li>
        ))}
      </ul>
      <a class="btn btn--secondary" href="/standards/">Read our standards</a>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 820px; }
  .hero-day { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; color: var(--heading); }
  .hero-day :global(svg) { width: 22px; height: 22px; color: var(--color-leaf); }
  .under-cards { margin-top: 1.5rem; font-size: 1.05em; }
  .more { margin-top: 1.25rem; }
  .weekly { display: flex; gap: 1rem; align-items: center; background: var(--surface); border: 1px solid var(--line); border-left: 5px solid var(--color-leaf); border-radius: var(--radius); padding: 1.25rem; }
  .weekly .icon-badge { margin: 0; flex: none; }
  .weekly .eyebrow { margin: 0; }
  .weekly__text { font-size: 1.15rem; margin: 0; }
  .promises { list-style: none; padding: 0; margin-bottom: 1.5rem; }
  .promises li { margin: 0; }
</style>
