---
import BaseLayout from '../layouts/BaseLayout.astro';
import DayCounter from '../components/DayCounter.astro';
import StoryList from '../components/StoryList.astro';
import Icon from '../components/Icon.astro';
import IntroVideo from '../components/IntroVideo.astro';
import PostCard from '../components/PostCard.astro';
import QuoteCard from '../components/QuoteCard.astro';
import TakeActionCards from '../components/TakeActionCards.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import PhotoFig from '../components/Photo.astro';
import PhotoMosaic from '../components/PhotoMosaic.astro';
import { programmes } from '../data/programmes';
import { photos } from '../data/photos';
import { currentTheme, weeklyAction, publishedStories, publishedPosts, monthName, campaignUrl, approachStages } from '../lib/content';

const theme = await currentTheme();
const action = weeklyAction(theme);
const stories = await publishedStories();
const featured = stories.filter((s) => s.data.featured).slice(0, 3);
const latest = stories.slice(0, 3);
const posts = (await publishedPosts()).slice(0, 3);
const stage = approachStages.find((s) => s.key === theme?.data.stage);
// Sections alternate white / light blue; the stories band only appears once there is content.
const hasStories = featured.length > 0 || latest.length > 0 || posts.length > 0;

const beliefs = [
  { icon: 'leaf', text: 'Peace is more than the absence of violence.' },
  { icon: 'generations', text: 'Every generation matters.' },
  { icon: 'message', text: 'Dialogue matters.' },
  { icon: 'book', text: 'Stories can change perspectives.' },
  { icon: 'hand', text: 'Peace is everyone’s responsibility.' },
  { icon: 'sprout', text: 'We choose what we pass on.' },
] as const;
---
<BaseLayout hideTakePart>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Independent · Youth-led · Non-partisan</p>
        <h1>Every generation inherits something. We can decide what we pass on.</h1>
        <p class="lede">Peace Across Generations is an independent, youth-led and non-partisan peacebuilding initiative connecting South Sudanese across communities, generations and borders to speak, listen, create and act for peace.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/campaigns/current/" data-track="cta:join-hero">Join the conversation</a>
          <a class="btn btn--secondary" href="/take-action/share-your-voice/" data-track="cta:share-hero">Share your voice</a>
        </div>
        <p class="hero-day"><Icon name="sun" /><a href="/3000-days/"><DayCounter /></a></p>
      </div>
      <div class="hero__media"><IntroVideo /></div>
    </div>
  </section>

  <!-- Why we exist -->
  <section class="section">
    <div class="container why reveal">
      <div>
        <p class="eyebrow">Why we exist</p>
        <h2>Why Peace Cannot Wait</h2>
        <p class="lede">South Sudan’s young people are too often recruited, displaced or left out of decisions. They are also students, creators, entrepreneurs and organisers — the builders of everyday peace.</p>
        <p>Social media is our entry point, not our destination. We succeed when a post becomes a conversation, a conversation becomes an action, and an action becomes a peaceful habit.</p>
        <a class="text-link" href="/about/">Our story →</a>
      </div>
      <PhotoFig photo={photos.footballTeamKneeling1} ratio="portrait" sizes="(min-width: 900px) 38vw, 100vw" widths={[400, 640, 900]} />
    </div>
  </section>

  <!-- What we believe -->
  <section class="section section--surface" aria-labelledby="believe">
    <div class="container reveal">
      <h2 id="believe" class="center">What we believe</h2>
      <ul class="beliefs">
        {beliefs.map((b) => <li><span class="icon-badge"><Icon name={b.icon} /></span><p>{b.text}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- Featured campaign -->
  {theme && (
    <section class="section" aria-labelledby="campaign">
      <div class="container reveal">
        <div class="campaign">
          <div>
            <p class="eyebrow">This month’s campaign · {monthName(theme.data.month)}{stage && ` · ${stage.n} ${stage.name}`}</p>
            <h2 id="campaign">{theme.data.title}</h2>
            <p class="campaign__msg">{theme.data.message ?? theme.data.creativePrompt}</p>
            <div class="btn-row">
              <a class="btn btn--primary" href={campaignUrl(theme)} data-track="cta:join-campaign">Join the conversation</a>
              <a class="btn btn--secondary" href="/take-action/share-your-voice/" data-track="cta:share-campaign">Share your voice</a>
            </div>
          </div>
          {action && (
            <aside class="weekly">
              <p class="eyebrow">Peace Where We Live</p>
              <p><strong>This weekend:</strong> {action.action}</p>
            </aside>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Programmes -->
  <section class="section section--surface" aria-labelledby="ways-in">
    <div class="container reveal">
      <div class="head-row">
        <div>
          <p class="eyebrow">Our programmes</p>
          <h2 id="ways-in">Four ways in</h2>
        </div>
        <a class="text-link" href="/programmes/">All programmes →</a>
      </div>
      <div class="grid grid--4">{programmes.map((p) => <ProgrammeCard {...p} />)}</div>
    </div>
  </section>

  <!-- Moments -->
  <section class="section" aria-labelledby="moments">
    <div class="container reveal">
      <p class="eyebrow">Moments</p>
      <h2 id="moments">Peace, practised together</h2>
      <PhotoMosaic photos={[photos.footballDuel, photos.workshopDiscussion, photos.certificatesGroup1, photos.groupWithBooklets, photos.workshop2]} />
    </div>
  </section>

  <!-- Stories, voices and blog: only once there is published content -->
  {hasStories && (
    <section class="section section--surface" aria-labelledby="latest">
      <div class="container reveal">
        <div class="head-row">
          <h2 id="latest">Stories & voices</h2>
          <a class="text-link" href="/stories/">All stories →</a>
        </div>
        {featured.length > 0 && <div class="grid grid--3 block">{featured.map((s) => <QuoteCard story={s} />)}</div>}
        {latest.length > 0 && <div class="block"><StoryList stories={latest} /></div>}
        {posts.length > 0 && (
          <div class="block">
            <h3>From the blog</h3>
            <div class="grid grid--3">{posts.map((p) => <PostCard post={p} />)}</div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Take action -->
  <section class:list={['section', { 'section--surface': !hasStories }]} aria-labelledby="act">
    <div class="container reveal">
      <p class="eyebrow">Take action</p>
      <h2 id="act">You don’t need money, a title or perfect English.</h2>
      <p class="lede">If you have a phone, a pen or a voice, there is a place for you here.</p>
      <TakeActionCards />
    </div>
  </section>

  <!-- Closing: 3,000-day countdown + newsletter -->
  <section class:list={['section', { 'section--surface': hasStories }]} aria-labelledby="days">
    <div class="container closing reveal">
      <div>
        <p class="eyebrow">3,000 Days for Peace</p>
        <h2 id="days">3,000 days. One promise.</h2>
        <p>From 21 September 2026 to 7 December 2034, we keep peace visible, practical and passed between generations.</p>
        <DayCounter variant="large" />
        <p class="more"><a class="text-link" href="/3000-days/">Read the commitment →</a></p>
      </div>
      <div class="closing__news">
        <h2>Stay in the conversation</h2>
        <p>One short email a month: the new campaign, voices worth hearing and ways to take part.</p>
        <NewsletterForm source="home" id="newsletter-home" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .center { text-align: center; }
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.05fr 0.95fr; gap: 3.5rem; } }
  .hero h1 { font-size: clamp(2rem, 1.3rem + 3vw, 3.2rem); }
  .hero__media :global(.eyebrow) { display: none; }
  .hero__media :global(.video__facade) { box-shadow: 0 20px 50px rgb(0 51 102 / 0.18); }
  .hero-day { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.5rem; color: var(--heading); }
  .hero-day a { color: inherit; text-decoration: none; }
  .hero-day a:hover { text-decoration: underline; }
  .hero-day :global(svg) { width: 22px; height: 22px; color: var(--color-green); }

  .why { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .why { grid-template-columns: 1.25fr 0.75fr; gap: 4rem; } }

  .beliefs { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .beliefs { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .beliefs { grid-template-columns: repeat(3, 1fr); } }
  .beliefs li {
    margin: 0; max-width: none; display: flex; gap: 1rem; align-items: center;
    background: var(--surface); border-radius: var(--radius); padding: 1.1rem 1.25rem;
    box-shadow: 0 1px 2px rgb(0 51 102 / 0.05);
  }
  .beliefs .icon-badge { margin: 0; flex: none; color: var(--accent-text); }
  .beliefs p { margin: 0; font-family: var(--font-heading); font-weight: 600; color: var(--heading); font-size: 1.05rem; line-height: 1.35; }

  .campaign {
    display: grid; gap: 1.5rem; background: var(--surface); border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px); padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    box-shadow: 0 18px 44px rgb(0 51 102 / 0.1); border-top: 6px solid var(--color-green);
  }
  @media (min-width: 900px) { .campaign { grid-template-columns: 1.6fr 1fr; align-items: center; } }
  .campaign h2 { font-size: clamp(1.7rem, 1.2rem + 2vw, 2.6rem); }
  .campaign__msg { font-size: 1.2rem; max-width: 52ch; }
  .weekly { background: var(--color-sky-light); border-radius: var(--radius); padding: 1.25rem 1.4rem; }
  @media (prefers-color-scheme: dark) { .weekly { background: var(--surface-alt); } }
  .weekly .eyebrow { margin-bottom: 0.4rem; color: var(--accent-text); }
  .weekly p:last-child { margin: 0; font-size: 1.08rem; }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0.5rem 1rem; margin-bottom: 1.25rem; }
  .head-row h2 { margin: 0; }
  .block + .block { margin-top: 2rem; }

  .closing { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .closing { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .closing h2 { font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.9rem); }
  .closing .more { margin-top: 1rem; }
  .closing__news { background: var(--surface); border-radius: var(--radius); padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); box-shadow: var(--shadow); }
</style>
