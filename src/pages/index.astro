---
// Home. Colour rhythm uses only the three brand colours:
// White backgrounds and green bands; blue is for text, icons and small shapes.
// slideshow → white → GREEN band → white → off-white → white → off-white →
// white → white/green split → footer.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryList from '../components/StoryList.astro';
import Icon from '../components/Icon.astro';
import IntroVideo from '../components/IntroVideo.astro';
import PostCard from '../components/PostCard.astro';
import QuoteCard from '../components/QuoteCard.astro';
import PhotoMosaic from '../components/PhotoMosaic.astro';
import ProgrammesPanel from '../components/ProgrammesPanel.astro';
import HeroSlider from '../components/HeroSlider.astro';
import LiveCountdown from '../components/LiveCountdown.astro';
import NetworksMarquee from '../components/NetworksMarquee.astro';
import { photos, type Photo } from '../data/photos';
import site from '../data/site.json';
import { currentTheme, publishedStories, publishedPosts, monthName, campaignUrl, approachStages } from '../lib/content';

const theme = await currentTheme();
const stories = await publishedStories();
const featured = stories.filter((s) => s.data.featured).slice(0, 3);
const latest = stories.slice(0, 3);
const posts = (await publishedPosts()).slice(0, 3);
const stage = approachStages.find((s) => s.key === theme?.data.stage);
const hasStories = featured.length > 0 || latest.length > 0 || posts.length > 0;
const campaignPhoto: Photo = (theme?.data.gallery?.[0] && (photos as Record<string, Photo>)[theme.data.gallery[0]]) || photos.peaceSignNight;

const beliefs = [
  'Peace is more than the absence of violence.',
  'Every generation matters.',
  'Dialogue matters.',
  'Stories can change perspectives.',
  'Peace is everyone’s responsibility.',
  'We choose what we pass on.',
];
const actions = [
  { href: '/take-action/share-your-voice/', title: 'Share your voice', text: 'A video, letter, poem, song or artwork for this month’s campaign.' },
  { href: '/take-action/become-a-peace-ambassador/', title: 'Become a Peace Ambassador', text: 'Carry peace into your school, community and online spaces.' },
  { href: '/take-action/volunteer/', title: 'Volunteer', text: 'Translate, caption, edit audio or help document safe peace actions.' },
  { href: '/take-action/partner/', title: 'Partner with us', text: 'Schools, media, radio, youth networks and organisations.' },
];
---
<BaseLayout hideTakePart>
  <!-- 1. Slideshow (navy) -->
  <HeroSlider />

  <!-- 2. Who we are + this month's campaign (white) -->
  <section class="section" aria-labelledby="who">
    <div class="container intro reveal">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2 id="who" class="visually-hidden">Who we are</h2>
        <p class="intro__text">Peace Across Generations is an independent, youth-led and non-partisan peacebuilding initiative for South Sudan. We use storytelling, letters, art, intergenerational dialogue, responsible digital communication and safe community action to make peaceful choices more visible in everyday life.</p>
        <p>Young people are at the centre — and elders, parents, teachers, artists, leaders and the diaspora all have a place here.</p>
        <a class="text-link" href="/about/">About us →</a>
      </div>
      {theme && (
        <article class="campaign-card">
          <div class="campaign-card__img ld-hide">
            <Picture src={campaignPhoto.src} alt={campaignPhoto.alt} widths={[400, 700]} sizes="(min-width: 900px) 30vw, 100vw" formats={['avif', 'webp']} quality={60} loading="lazy" />
          </div>
          <div class="campaign-card__body">
            <p class="eyebrow">This month · {monthName(theme.data.month)}{stage && ` · ${stage.n} ${stage.name}`}</p>
            <h3>{theme.data.title}</h3>
            <p>{theme.data.message ?? theme.data.creativePrompt}</p>
            <a class="btn btn--primary btn--block btn--arrow" href={campaignUrl(theme)} data-track="cta:join-campaign">Join the campaign</a>
          </div>
        </article>
      )}
    </div>
  </section>

  <!-- 3. Mission (GREEN band) -->
  <section class="band-green mission">
    <div class="container mission__inner reveal">
      <h2 class="mission__title">Our <strong>Mission</strong></h2>
      <p class="mission__text">To connect and mobilise South Sudanese inside the country and across the world to speak, listen, create and act for peace through inclusive storytelling, responsible media, intergenerational dialogue and practical local action.</p>
      <a class="btn btn--light" href="/about/">About our mission</a>
    </div>
  </section>

  <!-- 4. Programmes (white) -->
  <section class="section" aria-labelledby="programmes">
    <div class="container reveal">
      <div class="section-title">
        <p class="eyebrow">What we do</p>
        <h2 id="programmes">Four ways in</h2>
        <p>Every month, all four programmes answer the same campaign — so one idea reaches you as a poem, a club session, an expert talk and an elder’s story.</p>
      </div>
      <ProgrammesPanel />
    </div>
  </section>

  <!-- 5. Why peace cannot wait + live countdown (off-white) -->
  <section class="section band-off" aria-labelledby="why">
    <div class="container why reveal">
      <div>
        <p class="eyebrow">Why we exist</p>
        <h2 id="why">Why Peace Cannot Wait</h2>
        <p class="why__lede">South Sudan’s young people are too often recruited, displaced or left out of decisions. They are also students, creators, entrepreneurs and organisers — the builders of everyday peace.</p>
        <p>From 21 September 2026 to 7 December 2034 we keep peace visible, practical and passed between generations — <strong>3,000 days, one promise.</strong></p>
        <a class="text-link" href="/3000-days/">Read the commitment →</a>
      </div>
      <LiveCountdown variant="light" />
    </div>
  </section>

  <!-- 6. What we believe (white) -->
  <section class="section" aria-labelledby="believe">
    <div class="container reveal">
      <div class="section-title section-title--center">
        <p class="eyebrow">Our values</p>
        <h2 id="believe">What we believe</h2>
      </div>
      <ol class="beliefs">
        {beliefs.map((b, i) => <li><span class="beliefs__n">{String(i + 1).padStart(2, '0')}</span><p>{b}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- 7. Take action (off-white) -->
  <section class="section band-off" aria-labelledby="act">
    <div class="container act reveal">
      <div class="act__photo ld-hide">
        <Picture src={photos.certificatesGroup1.src} alt={photos.certificatesGroup1.alt} widths={[400, 700, 1000]} sizes="(min-width: 900px) 45vw, 100vw" formats={['avif', 'webp']} quality={60} loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Take action</p>
        <h2 id="act">You don’t need money, a title or perfect English.</h2>
        <p>If you have a phone, a pen or a voice, there is a place for you here.</p>
        <ul class="act__list">
          {actions.map((a) => (
            <li><a href={a.href}><strong>{a.title}</strong><span>{a.text}</span><Icon name="arrow" /></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 8. Moments (white) -->
  <section class="section" aria-labelledby="moments">
    <div class="container reveal">
      <div class="section-title">
        <p class="eyebrow">Moments</p>
        <h2 id="moments">Peace, practised together</h2>
      </div>
      <PhotoMosaic photos={[photos.footballDuel, photos.workshopDiscussion, photos.groupWithBooklets, photos.footballTeamKneeling1, photos.workshop2]} />
    </div>
  </section>

  {hasStories && (
    <section class="section band-off" aria-labelledby="latest">
      <div class="container reveal">
        <div class="head-row">
          <div class="section-title"><p class="eyebrow">Stories & voices</p><h2 id="latest">Latest from our community</h2></div>
          <a class="text-link" href="/stories/">All stories →</a>
        </div>
        {featured.length > 0 && <div class="grid grid--3 block">{featured.map((s) => <QuoteCard story={s} />)}</div>}
        {latest.length > 0 && <div class="block"><StoryList stories={latest} /></div>}
        {posts.length > 0 && <div class="block grid grid--3">{posts.map((p) => <PostCard post={p} />)}</div>}
      </div>
    </section>
  )}

  <!-- 9. Networks we aspire to work with -->
  <section class:list={['section', { 'band-off': !hasStories }]} aria-label="Networks we aspire to work with">
    <div class="container reveal"><NetworksMarquee /></div>
  </section>

  <!-- 10. Split: video (navy) / questions (green) -->
  <section class="split-band">
    <div class="split-band__video">
      <div class="split-band__inner">
        <p class="eyebrow">Our story</p>
        <h2>Watch: What’s P.A.G?</h2>
        <IntroVideo />
        {site.socials.youtube && <p><a class="text-link" href={site.socials.youtube} rel="noopener">Subscribe on YouTube →</a></p>}
      </div>
    </div>
    <div class="split-band__ask">
      <div class="split-band__inner">
        <h2>Questions about Peace Across Generations?</h2>
        <p>Write to us — we read every message. Or join the newsletter for one short email a month.</p>
        <div class="btn-row">
          <a class="btn btn--light btn--arrow" href="/contact/">Contact us</a>
          <a class="btn btn--ghost" href="/newsletter/">Join the newsletter</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Who we are */
  .intro { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .intro { grid-template-columns: 1.35fr 1fr; gap: 4.5rem; } }
  .intro__text { font-family: var(--font-heading); font-weight: 600; color: var(--heading); font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem); line-height: 1.45; max-width: 34ch; }
  .intro__text::first-letter { float: left; font-weight: 700; font-size: 3.4em; line-height: 0.82; margin: 0.06em 0.12em 0 0; color: var(--color-green); }
  .campaign-card { background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: 0 24px 60px rgb(0 51 102 / 0.14); border-top: 6px solid var(--color-green); }
  .campaign-card__img :global(img) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .campaign-card__body { padding: 1.5rem; }
  .campaign-card h3 { font-size: 1.5rem; }

  /* Mission (green band) */
  .mission__inner { display: grid; gap: 1rem 3rem; align-items: center; padding-block: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem); }
  @media (min-width: 900px) { .mission__inner { grid-template-columns: auto 1fr auto; } }
  .mission__title { margin: 0; font-weight: 400; font-size: clamp(2rem, 1.5rem + 1.5vw, 2.8rem); white-space: nowrap; }
  .mission__title strong { font-weight: 700; }
  .mission__text { margin: 0; font-family: var(--font-heading); font-weight: 600; font-size: 1.05rem; max-width: none; }

  /* Why + countdown */
  .why { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .why { grid-template-columns: 1fr 1.05fr; gap: 4.5rem; } }
  .why h2 { font-size: clamp(1.9rem, 1.3rem + 2vw, 2.8rem); }
  .why__lede { font-size: 1.15rem; }

  /* Values */
  .beliefs { list-style: none; padding: 0; margin: 0; display: grid; border-top: 2px solid var(--color-navy); }
  @media (min-width: 700px) { .beliefs { grid-template-columns: repeat(2, 1fr); column-gap: 3rem; } }
  @media (min-width: 1000px) { .beliefs { grid-template-columns: repeat(3, 1fr); } }
  .beliefs li { margin: 0; max-width: none; display: flex; gap: 1rem; align-items: baseline; padding: 1.35rem 0; border-bottom: 1px solid var(--line); }
  .beliefs__n { font-family: var(--font-heading); font-weight: 700; color: var(--color-green); font-size: 1rem; }
  .beliefs p { margin: 0; font-family: var(--font-heading); font-weight: 600; color: var(--heading); font-size: 1.15rem; line-height: 1.35; }

  /* Take action */
  .act { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .act { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .act__photo :global(img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); box-shadow: 0 24px 60px rgb(0 51 102 / 0.18); }
  .act h2 { font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.5rem); }
  .act__list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.75rem; }
  .act__list li { margin: 0; max-width: none; }
  .act__list a {
    display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 1rem; align-items: center;
    background: #fff; text-decoration: none; border-radius: var(--radius-sm); padding: 1rem 1.2rem;
    border-left: 5px solid var(--color-green); box-shadow: 0 2px 10px rgb(0 51 102 / 0.06); transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .act__list a:hover { transform: translateX(4px); box-shadow: 0 10px 24px rgb(0 51 102 / 0.12); }
  .act__list strong { font-family: var(--font-heading); color: var(--color-navy); font-size: 1.05rem; }
  .act__list span { grid-column: 1; font-size: 0.93rem; color: var(--text-muted); }
  .act__list :global(svg) { grid-column: 2; grid-row: 1 / span 2; width: 22px; height: 22px; color: var(--color-green); }

  /* Split band: white / green */
  .split-band { display: grid; }
  @media (min-width: 960px) { .split-band { grid-template-columns: 1.15fr 1fr; } }
  .split-band__video { background: #fff; color: var(--text); border-top: 1px solid var(--line); }
  .split-band__ask { background: linear-gradient(135deg, #245a26, var(--color-green)); color: #fff; display: flex; align-items: center; }
  .split-band__inner { padding: clamp(2.5rem, 2rem + 3vw, 5rem) clamp(1rem, 4vw, 4.5rem); max-width: 720px; }
  .split-band__ask h2 { color: #fff; }
  .split-band h2 { font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.4rem); }
  .split-band__video .eyebrow { color: var(--accent-text); }
  .split-band__video :global(.intro-video .eyebrow) { display: none; }
  .split-band__ask :global(a:not(.btn)) { color: #fff; }
  
  .split-band__ask p { color: #fff; }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0.5rem 1rem; }
  .block + .block { margin-top: 2rem; }
</style>
