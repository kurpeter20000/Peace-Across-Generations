---
import { photos } from '../../data/photos';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import StoryList from '../../components/StoryList.astro';
import StoryFilters from '../../components/StoryFilters.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import ContributorCard from '../../components/ContributorCard.astro';
import foundingCreators from '../../data/founding-creators.json';
import { publishedStories } from '../../lib/content';

const stories = await publishedStories();
const featured = stories.filter((s) => s.data.featured).slice(0, 3);
const creatorOfMonth = stories.find((s) => s.data.creatorOfTheMonth);
const founders = foundingCreators as string[];
const contributors = await getCollection('contributors', ({ data }) => !data.draft && data.profileConsent === true);
---
<BaseLayout title="Stories & Voices" description="Videos, stories, letters, poetry, music, art, drama and conversations from South Sudanese at home and around the world.">
  <PageHead photo={photos.footballTeam1} title="Stories & Voices" lede="Videos, stories, letters, poetry, music, art, drama and conversations from South Sudanese at home and around the world — young people, elders, women, artists, educators, community leaders, peacebuilders and the diaspora." />

  <StoryFilters />

  {featured.length > 0 && (
    <section class="section section--tight" aria-labelledby="featured">
      <div class="container">
        <h2 id="featured">Featured voices</h2>
        <div class="grid grid--3">{featured.map((s) => <QuoteCard story={s} />)}</div>
      </div>
    </section>
  )}

  {(creatorOfMonth || founders.length > 0) && (
    <section class="section section--tight">
      <div class="container grid grid--2">
        {creatorOfMonth && (
          <div class="card spot">
            <p class="eyebrow">Creator of the Month</p>
            <h2><a href={`/stories/${creatorOfMonth.id}/`}>{creatorOfMonth.data.title}</a></h2>
            <p>{creatorOfMonth.data.anonymous ? 'Anonymous creator' : creatorOfMonth.data.contributorDisplayName}</p>
          </div>
        )}
        {founders.length > 0 && (
          <div class="card spot">
            <p class="eyebrow">Founding Creators</p>
            <ul class="founders">{founders.map((n) => <li>{n}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section section--surface">
    <div class="container">
      <h2 class="visually-hidden">All stories and voices</h2>
      <StoryList stories={stories} />
    </div>
  </section>

  {contributors.length > 0 && (
    <section class="section" aria-labelledby="contributors">
      <div class="container">
        <h2 id="contributors">Contributors</h2>
        <div class="grid grid--3">{contributors.map((c) => <ContributorCard contributor={c} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .spot { border-top: 6px solid var(--color-leaf); }
  .founders { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .founders li { margin: 0; }
</style>
