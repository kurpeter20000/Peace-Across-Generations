---
// Serves both the library sections (/stories/letters …) and single
// stories (/stories/<file-name>).
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import StoryList from '../../components/StoryList.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import SafetyNote from '../../components/SafetyNote.astro';
import SocialShare from '../../components/SocialShare.astro';
import StoryFilters from '../../components/StoryFilters.astro';
import site from '../../data/site.json';
import { programmeNames } from '../../data/programmes';
import { t } from '../../i18n';
import {
  publishedStories, publishedThemes, storySections, typeLabels, formatDate, monthName, contributorCategoryLabels, type Story,
} from '../../lib/content';

type SectionKey = keyof typeof storySections;
type Props = { kind: 'section'; section: SectionKey; stories: Story[] } | { kind: 'story'; story: Story };

export async function getStaticPaths() {
  const stories = await publishedStories();
  const sections = Object.entries(storySections).map(([slug, s]) => ({
    params: { slug },
    props: { kind: 'section' as const, section: slug as SectionKey, stories: stories.filter((st) => (s.types as readonly string[]).includes(st.data.type)) },
  }));
  const reserved = new Set(Object.keys(storySections));
  const items = stories
    .filter((s) => {
      if (reserved.has(s.id)) console.warn(`[PAG] Story file name "${s.id}" clashes with a library section; rename it.`);
      return !reserved.has(s.id);
    })
    .map((story) => ({ params: { slug: story.id }, props: { kind: 'story' as const, story } }));
  return [...sections, ...items];
}

const props = Astro.props as Props;
const themes = Object.fromEntries((await publishedThemes()).map((th) => [th.id, th]));

// Single-story values (unused on section pages)
const s = props.kind === 'story' ? props.story : undefined;
const d = s?.data as Story['data'];
const Content = s ? (await render(s)).Content : undefined;
const theme = d?.theme ? themes[d.theme] : undefined;
const url = s ? new URL(`/stories/${s.id}/`, Astro.site).toString() : '';
const ageLabels: Record<string, string> = { '18-24': '18–24', '25-35': '25–35', '36-59': '36–59', '60-plus': '60 and over', 'over-35': 'over 35' };
// Full-size optimised image for the low-data "View the image" link.
const fullImage = d?.image ? await getImage({ src: d.image.src, width: 1600, format: 'webp' }) : undefined;
const ld = d?.audio
  ? {
      '@context': 'https://schema.org',
      '@type': d.type === 'episode' ? 'PodcastEpisode' : 'AudioObject',
      name: d.title,
      datePublished: d.date.toISOString().slice(0, 10),
      inLanguage: d.langCode ?? 'en',
      ...(d.type === 'episode'
        ? { associatedMedia: { '@type': 'AudioObject', contentUrl: new URL(d.audio.src, Astro.site).toString() } }
        : { contentUrl: new URL(d.audio.src, Astro.site).toString() }),
    }
  : undefined;
---
{props.kind === 'section' ? (
  <BaseLayout title={storySections[props.section].title}>
    <PageHead title={storySections[props.section].title} eyebrow="Stories & Voices" />
    <StoryFilters current={`/stories/${props.section}/`} />
    <section class="section section--surface">
      <div class="container"><StoryList stories={props.stories} /></div>
    </section>
  </BaseLayout>
) : (
  <BaseLayout title={d.title} description={d.englishSummary ?? `${typeLabels[d.type]} · ${site.name}`} ogType="article" jsonLd={ld}>
        <article>
          <header class="page-head">
            <div class="container narrow">
              <p class="tag" data-programme={d.programme}>{typeLabels[d.type]} · {programmeNames[d.programme]}</p>
              <h1>{d.title}</h1>
              <ul class="meta">
                <li>{d.anonymous ? 'Anonymous' : d.contributorDisplayName}</li>
                {d.contributorCategories.length > 0 && <li>{d.contributorCategories.map((c) => contributorCategoryLabels[c]).join(', ')}</li>}
                {d.ageGroup && d.ageGroup !== 'under-18' && <li>Age {ageLabels[d.ageGroup]}</li>}
                {d.location && <li>{d.location}</li>}
                <li>{d.language}</li>
                {theme && <li><a href={`/campaigns/${theme.id}/`}>{monthName(theme.data.month).split(' ')[0]}: {theme.data.title}</a></li>}
                <li><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></li>
              </ul>
            </div>
          </header>

          <div class="container narrow story-body">
            {(d.contentWarning || theme?.data.contentWarning) && (
              <SafetyNote title="Take care" variant="warning" headingLevel="h2"><p>{t('contentWarning')}</p></SafetyNote>
            )}

            {d.image && (
              <figure class="ld-hide">
                <Picture src={d.image.src} alt={d.image.alt} widths={[480, 800, 1200]} sizes="(min-width: 800px) 760px, 100vw" formats={['avif', 'webp']} loading="lazy" />
              </figure>
            )}
            {d.image && fullImage && <p class="ld-only"><a href={fullImage.src}>View the image</a> ({d.image.alt})</p>}

            {d.video && <VideoFacade platform={d.video.platform} url={d.video.url} thumbnail={d.video.thumbnail} title={d.title} />}
            {d.audio && <AudioPlayer src={d.audio.src} sizeMB={d.audio.sizeMB} durationMin={d.audio.durationMin} title={d.title} />}

            <div class="prose" lang={d.langCode}>
              {Content && <Content />}
            </div>

            {d.englishSummary && (
              <section class="card summary">
                <h2>{d.langCode && d.langCode !== 'en' ? 'English summary' : 'Summary'}</h2>
                <p>{d.englishSummary}</p>
              </section>
            )}
            {d.translatedBy && <p class="muted">Translated by {d.translatedBy}, edited with the contributor’s approval.</p>}

            {d.sources.length > 0 && (
              <section>
                <h2>Sources</h2>
                <ul>{d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.label}</a></li>)}</ul>
              </section>
            )}

            <div class="grid grid--2 reflect">
              <div class="card"><p class="eyebrow">One question</p><p>{d.reflectionQuestion}</p></div>
              <div class="card"><p class="eyebrow">One action</p><p>{d.action}</p></div>
            </div>

            <SocialShare title={d.title} url={url} />

            <p class="consent-note">{t('consentNote')} <a href="/standards/corrections-and-withdrawal/">{t('consentNoteLink')}</a>.</p>
          </div>
        </article>
      </BaseLayout>
)}

<style>
  .narrow { max-width: 760px; }
  .meta { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; color: var(--text-muted); }
  .meta li { margin: 0; }
  .story-body > :global(* + *) { margin-top: 1.5rem; }
  .story-body h2 { font-size: 1.25rem; }
  .prose { font-size: 1.1em; }
  figure { margin: 0; }
  figure :global(img) { border-radius: var(--radius); width: 100%; height: auto; }
  .reflect .card { border-top: 4px solid var(--color-leaf); }
  .reflect .card p:last-child { font-weight: 600; color: var(--heading); }
  .consent-note { font-size: 0.95rem; border-top: 1px solid var(--line); padding-top: 1rem; margin-bottom: 3rem; }
</style>
