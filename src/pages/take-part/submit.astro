---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Email from '../../components/Email.astro';
import SafetyNote from '../../components/SafetyNote.astro';
import Tbd from '../../components/Tbd.astro';
import { currentTheme } from '../../lib/content';

const theme = await currentTheme();
const themeName = theme?.data.title ?? 'this month’s theme';

const template = `Hello Peace Across Generations,
Here is my submission for ${themeName}.
Name to show (or "Anonymous"):
Age group:
Country / state:
Language:
Short English summary:
This is my own work: Yes / Credit to:
I agree you may edit lightly and publish: Yes
You may tag me: Yes / No
Anything we should know for my safety:
`;
---
<BaseLayout title="How to send your work" description="What you can send, what to tell us, and how to send your work to Peace Across Generations by WhatsApp or email." hideTakePart>
  <PageHead title="How to send your work" />

  <section class="section section--tight">
    <div class="container grid grid--2">
      <div>
        <h2>What you can send</h2>
        <ul>
          <li>A video, ideally 30–120 seconds, vertical or horizontal</li>
          <li>A Letter for Peace of up to 500 words — or a voice note and we will read it for you</li>
          <li>A drawing, photo, poem, song, short drama or spoken-word piece</li>
          <li>An interview with an elder, or a response from a community leader</li>
          <li>A short report of a peace action you did at home, at school, in your community or in the diaspora</li>
        </ul>
      </div>
      <div>
        <h2>Tell us, with your work</h2>
        <ol>
          <li>The name you want shown — or say if you want to stay anonymous or use a pen name</li>
          <li>Your age group (under 18 / 18–24 / 25–35 / over 35)</li>
          <li>Your country, and your state or community connection if you are comfortable sharing it</li>
          <li>The language of your work, and a short English summary if you can</li>
          <li>That the work is yours, or who you are crediting</li>
          <li>That you agree we can lightly edit and publish it, and whether we may tag you</li>
          <li>Anything we should know to keep you safe</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SafetyNote title="Under 18?">
        <p>A parent or guardian must also agree. <Tbd>Download guardian consent form (PDF, size to be added)</Tbd></p>
      </SafetyNote>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="send">
    <div class="container">
      <h2 id="send">Send it</h2>
      <div class="grid grid--2">
        <div class="card send">
          <h3>WhatsApp</h3>
          <p>The easiest way from a phone. The message below is filled in for you.</p>
          <WhatsAppButton text={template} block />
        </div>
        <div class="card send">
          <h3>Email</h3>
          <p><Email /></p>
          <Email class="btn btn--secondary btn--block" label="Send by email" icon subject={`Submission – ${themeName}`} body={template} />
        </div>
      </div>
      <details class="template">
        <summary>See the message template</summary>
        <pre>{template}</pre>
      </details>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <div>
        <h2>What happens next</h2>
        <p>We check every piece for consent, facts and safety. If we need to change its meaning, translate it or change how you are named, we ask you first. You can ask us to remove your work at any time. <a href="/standards/corrections-and-withdrawal/">Corrections and withdrawal →</a></p>
      </div>
      <div>
        <h2>Why we may not publish something</h2>
        <p>We will not publish anything that calls for violence or revenge, uses slurs, blames a whole community, shows graphic images or real weapons, accuses a named person without evidence, or reveals someone’s exact location. We may also hold back work that could put you at risk — your safety matters more than a post.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h2 { font-size: 1.4rem; }
  .send { display: flex; flex-direction: column; }
  .send > :last-child { margin-top: auto; }
  .template { margin-top: 1.5rem; }
  .template summary { cursor: pointer; color: var(--link); font-weight: 600; }
  pre { white-space: pre-wrap; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 1rem; font-size: 0.95rem; }
</style>
