---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { currentTheme, monthName } from '../../lib/content';

const theme = await currentTheme();

const pathways = [
  { icon: 'pen', name: 'Create', examples: 'Video, letter, poem, drawing, song, photo, short drama', best: 'Youth, artists, students, diaspora creators' },
  { icon: 'message', name: 'Converse', examples: 'Interview an elder, join a live session, talk as a family', best: 'Youth, elders, teachers, leaders' },
  { icon: 'sprout', name: 'Act', examples: 'School activity, peace wall, community reading, checking a rumour', best: 'Clubs, schools, community groups' },
  { icon: 'globe', name: 'Amplify', examples: 'Translate, caption, share responsibly, introduce us to your network', best: 'Diaspora, media, supporters' },
  { icon: 'hand', name: 'Enable', examples: 'Mentor, offer expertise, airtime, a safe venue or funding', best: 'Partners and professionals' },
] as const;

const prompts = [
  ['Video', 'What is one form of violence South Sudanese have normalised that our generation must reject?'],
  ['Letter', 'Write to a child who will inherit South Sudan in 2040. What must we change before then?'],
  ['Elder interview', 'What traditional practice helped your community prevent or resolve conflict?'],
  ['Art', 'What does peace look like in an ordinary South Sudanese day?'],
  ['Leader response', 'What concrete action will you take to protect young people from violence and hate?'],
  ['Global solidarity', 'What lesson from your community could encourage South Sudanese peacebuilders without speaking for them?'],
];
---
<BaseLayout title="Take part" description="You don't need money, a title, professional equipment or perfect English. Five ways to take part in Peace Across Generations this month." hideTakePart>
  <PageHead title="Take part" lede="You don’t need money, a title, professional equipment or perfect English." />

  <section class="section section--surface" aria-labelledby="how">
    <div class="container">
      <h2 id="how">Choose how</h2>
      <ul class="grid grid--3 plain">
        {pathways.map((p) => (
          <li class="card">
            <span class="icon-badge"><Icon name={p.icon} /></span>
            <h3>{p.name}</h3>
            <p>{p.examples}</p>
            <p class="muted"><strong>Best for:</strong> {p.best}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {theme && (
    <section class="section" aria-labelledby="prompt">
      <div class="container">
        <div class="card month">
          <p class="eyebrow">This month’s prompt · {monthName(theme.data.month)}</p>
          <h2 id="prompt">{theme.data.title}</h2>
          <p class="month__prompt">{theme.data.creativePrompt}</p>
          <a class="text-link" href="/this-month/">More about this month’s theme →</a>
        </div>
      </div>
    </section>
  )}

  <section class="section section--surface" aria-labelledby="bank">
    <div class="container">
      <h2 id="bank">Prompt bank</h2>
      <p>These prompts work any month.</p>
      <dl class="grid grid--2 prompts">
        {prompts.map(([k, v]) => <div class="card"><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="btn-row"><a class="btn btn--primary" href="/take-part/submit/">How to send your work →</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .plain { list-style: none; padding: 0; }
  .plain li { margin: 0; }
  .month { border-top: 6px solid var(--color-green); }
  .month__prompt { font-family: var(--font-heading); font-weight: 600; font-size: 1.25rem; color: var(--heading); }
  .prompts { margin: 0; }
  dt { font-family: var(--font-heading); font-weight: 700; color: var(--accent-text); text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
  dd { margin: 0; font-size: 1.05rem; }
</style>
