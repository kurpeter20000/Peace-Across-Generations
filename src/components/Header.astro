---
import Icon from './Icon.astro';
import DayCounter from './DayCounter.astro';
import Photo from './Photo.astro';
import { photos } from '../data/photos';
import { t } from '../i18n';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
type Item = { href: string; label: string; icon?: string; desc?: string; children?: { href: string; label: string; icon?: string; desc?: string }[]; panel?: { photo: (typeof photos)[keyof typeof photos]; caption: string } };
const links: Item[] = [
  { href: '/', label: t('nav.home') },
  {
    href: '/about/', label: t('nav.about'),
    panel: { photo: photos.founderPortrait, caption: 'Meet our founder and team' },
    children: [
      { href: '/about/', label: 'About us', icon: 'leaf', desc: 'Our mission, vision and story' },
      { href: '/about/team/', label: 'Our team', icon: 'users', desc: 'The people leading the work' },
      { href: '/3000-days/', label: '3,000 Days for Peace', icon: 'calendar', desc: 'Our commitment to 2034' },
    ],
  },
  { href: '/programmes/', label: t('nav.programmes') },
  {
    href: '/campaigns/', label: 'Campaigns & Stories',
    panel: { photo: photos.megaphone, caption: 'Real voices from South Sudan' },
    children: [
      { href: '/campaigns/current/', label: 'This month\u2019s campaign', icon: 'sun', desc: 'What we\u2019re asking right now' },
      { href: '/campaigns/', label: 'All campaigns', icon: 'calendar', desc: 'Every theme, month by month' },
      { href: '/stories/', label: 'Stories & Voices', icon: 'heart', desc: 'Letters, poems, songs and film' },
    ],
  },
  { href: '/take-action/', label: t('nav.takeAction') },
  { href: '/resources/', label: t('nav.resources') },
  { href: '/blog/', label: t('nav.blog') },
  { href: '/contact/', label: t('nav.contact') },
];
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(`${h}/`);
};
const clean = (href: string) => href.replace(/\/$/, '') || '/';
// A parent menu is "current" when you are on any of its pages.
const isSection = (item: Item) =>
  item.children ? item.children.some((c) => isCurrent(c.href)) : isCurrent(item.href);
---
<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__pos">{t('positioning.short')}</p>
    <a class="topbar__days" href="/3000-days/" aria-label="3,000 Days for Peace: see the commitment"><DayCounter /></a>
    <button class="lowdata-toggle" type="button" aria-pressed="false" data-lowdata-toggle title={t('lowData.hint')}>
      <span class="switch" aria-hidden="true"></span>
      <span>Low-data<span class="ld-word"> mode</span>: <span data-state>{t('lowData.off')}</span></span>
    </button>
  </div>
</div>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Peace Across Generations — home">
      <picture>
        <source srcset="/brand/pag-logo-400.webp" type="image/webp" />
        <img src="/brand/pag-logo-400.png" alt="Peace Across Generations" width="400" height="140" />
      </picture>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      <span class="visually-hidden">{t('menu')}</span>
    </button>

    <div class="site-menu" id="site-menu">
      <nav aria-label="Main">
        <ul>
          {links.map((l, i) => l.children ? (
            <li class="has-sub" data-sub>
              <button type="button" class:list={['sub-toggle', { current: isSection(l) }]} aria-expanded="false" aria-controls={`sub-${i}`} data-sub-toggle>
                {l.label}<svg class="caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="submenu" id={`sub-${i}`}>
                <ul class="submenu__list">
                  {l.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={path === clean(c.href) ? 'page' : undefined}>
                        {c.icon && <span class="submenu__icon"><Icon name={c.icon as any} /></span>}
                        <span><span class="submenu__label">{c.label}</span>{c.desc && <span class="submenu__desc">{c.desc}</span>}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                {l.panel && (
                  <div class="submenu__panel">
                    <Photo photo={l.panel.photo} ratio="portrait" sizes="140px" widths={[200, 280]} rounded={true} />
                    <p>{l.panel.caption}</p>
                  </div>
                )}
              </div>
            </li>
          ) : (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn--primary nav-cta" href="/campaigns/current/" data-track="cta:join-header">{t('cta.join')}</a>
    </div>
  </div>
</header>

<style>
  /* The logo's navy disappears on dark backgrounds, so the header stays
     white in both colour schemes (brief §4.1). */
  .topbar { background: #2e7130; color: #fff; font-size: 0.8rem; }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 36px; }
  .topbar__pos { margin: 0; letter-spacing: 0.08em; text-transform: uppercase; font-family: var(--font-heading); font-weight: 600; font-size: 0.72rem; }
  .lowdata-toggle {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 36px;
    background: none; border: 0; color: inherit; font: inherit; cursor: pointer; padding: 0 0.25rem;
  }
  .switch { width: 30px; height: 18px; border-radius: 999px; background: rgb(255 255 255 / 0.35); position: relative; flex: none; }
  .switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; transition: transform 0.15s; }
  .lowdata-toggle[aria-pressed='true'] .switch { background: #2e7130; }
  .lowdata-toggle[aria-pressed='true'] .switch::after { transform: translateX(12px); }
  .topbar :global(:focus-visible) { outline-color: #9fd67a; }
  .topbar__days { color: #fff; text-decoration: none; font-size: 0.78rem; }
  .topbar__days:hover { text-decoration: underline; color: #fff; }
  .topbar__days :global(.day-inline) { font-size: 0.78rem; }
  @media (max-width: 759px) { .topbar__days { display: none; } }

  .site-header {
    background: #fff; color: #003366; border-bottom: 1px solid #e3e7eb;
    position: sticky; top: 0; z-index: 50;
  }
  .site-header .container, .topbar .container { max-width: 1280px; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 78px; flex-wrap: wrap; }
  .site-header { box-shadow: 0 2px 14px rgb(0 51 102 / 0.06); }
  .brand { display: block; padding: 8px 0; line-height: 0; }
  .brand img { width: 176px; height: auto; }

  .menu-toggle {
    display: none; background: none; border: 2px solid #003366; color: #003366;
    border-radius: 10px; width: 48px; height: 48px; padding: 0; cursor: pointer;
    place-items: center;
  }
  .menu-toggle :global(svg) { width: 26px; height: 26px; }
  .menu-toggle :global(.i-close) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.i-close) { display: block; }

  .site-menu { display: flex; align-items: center; gap: 0.75rem; }
  nav ul { list-style: none; display: flex; gap: 0.1rem; margin: 0; padding: 0; }
  nav li { margin: 0; }
  nav a {
    display: block; padding: 0.55rem 0.45rem; border-radius: 8px; white-space: nowrap;
    color: #003366; text-decoration: none; font-family: var(--font-heading); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
  }
  nav a:hover { background: #f5f7f8; color: #2e7130; }
  nav a[aria-current='page'], .sub-toggle.current { text-decoration: underline; text-decoration-color: #2e7130; text-decoration-thickness: 3px; text-underline-offset: 0.4em; }

  /* Dropdowns */
  .has-sub { position: relative; }
  .sub-toggle {
    display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.55rem 0.45rem; border-radius: 8px;
    background: none; border: 0; cursor: pointer; white-space: nowrap;
    color: #003366; font-family: var(--font-heading); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
  }
  .sub-toggle:hover { background: #f5f7f8; color: #2e7130; }
  .caret { width: 12px; height: 12px; transition: transform 0.2s ease; }
  .sub-toggle[aria-expanded='true'] .caret { transform: rotate(180deg); }
  nav .submenu {
    display: none; flex-direction: column; position: absolute; top: calc(100% + 10px); left: 0; min-width: 210px; z-index: 60;
    padding: 0.6rem; background: #fff; gap: 0;
    border: 1px solid #e3e7eb; border-radius: 14px; box-shadow: 0 20px 44px rgb(0 51 102 / 0.16);
  }
  .submenu__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .submenu a {
    display: flex; align-items: flex-start; gap: 0.65rem; padding: 0.65rem 0.7rem; border-radius: 10px;
    text-transform: none; letter-spacing: 0; font-size: 0.92rem;
  }
  .submenu__icon {
    display: grid; place-items: center; flex: none; width: 30px; height: 30px; margin-top: 0.05rem;
    border-radius: 8px; background: var(--color-green-tint); color: var(--color-green-dark);
  }
  .submenu__icon :global(svg) { width: 16px; height: 16px; }
  .submenu__label { display: block; font-weight: 700; }
  .submenu__desc { display: block; font-family: var(--font-body); font-weight: 400; font-size: 0.8rem; color: var(--text-muted); text-transform: none; margin-top: 0.1rem; }
  /* Desktop: open on hover or keyboard focus (works without JavaScript), or when clicked. */
  @media (min-width: 1280px) {
    .has-sub:hover .submenu, .has-sub:focus-within .submenu, .sub-toggle[aria-expanded='true'] + .submenu { display: flex; }
    .has-sub::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 10px; }
    nav .submenu { min-width: 460px; flex-direction: row; align-items: stretch; }
    .submenu__list { flex: 1; justify-content: center; }
    .submenu__panel {
      flex: none; width: 150px; display: flex; flex-direction: column; gap: 0.6rem; padding: 0.5rem 0.5rem 0.5rem 0.9rem;
      margin-left: 0.4rem; border-left: 1px solid #eceff2; justify-content: center;
    }
    .submenu__panel p { margin: 0; font-family: var(--font-heading); font-weight: 600; font-size: 0.82rem; color: var(--color-navy); line-height: 1.3; }
  }
  @media (max-width: 1279px) { .submenu__panel { display: none; } }
  .nav-cta { background: #2e7130; color: #fff; white-space: nowrap; padding-inline: 1.2rem; border-radius: 4px; font-size: 0.8rem; }
  .nav-cta:hover { background: #245a26; color: #fff; }
  .site-header :global(:focus-visible) { outline-color: #2e7130; }

  /* Small screens: hamburger (only when JavaScript is available;
     without it the menu simply stays open below the logo). */
  @media (max-width: 1279px) {
    :global(.js) .menu-toggle { display: grid; }
    .site-menu { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0.5rem; padding-bottom: 1rem; }
    :global(.js) .site-menu:not([data-open]) { display: none; }
    nav ul { flex-direction: column; }
    nav a { padding: 0.85rem 0.5rem; font-size: 0.92rem; border-bottom: 1px solid #eceff2; border-radius: 0; }
    .sub-toggle { width: 100%; justify-content: space-between; padding: 0.85rem 0.5rem; font-size: 0.92rem; border-bottom: 1px solid #eceff2; border-radius: 0; }
    .submenu { position: static; box-shadow: none; border: 0; border-radius: 0; padding: 0 0 0 1rem; min-width: 0; background: #f5f7f8; }
    .submenu__icon { background: #fff; }
    .sub-toggle[aria-expanded='true'] + .submenu { display: flex; }
    :global(html:not(.js)) .submenu { display: flex; }
    .nav-cta { width: 100%; }
  }
  @media (max-width: 560px) {
    .topbar__pos { font-size: 0.62rem; letter-spacing: 0.03em; white-space: nowrap; }
    .ld-word { display: none; }
    .lowdata-toggle { white-space: nowrap; font-size: 0.74rem; }
  }
</style>
