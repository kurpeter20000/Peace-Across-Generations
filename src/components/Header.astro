---
import Icon from './Icon.astro';
import { t } from '../i18n';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: t('nav.home') },
  { href: '/about/', label: t('nav.about') },
  { href: '/programmes/', label: t('nav.programmes') },
  { href: '/this-month/', label: t('nav.thisMonth') },
  { href: '/stories/', label: t('nav.stories') },
];
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(`${h}/`);
};
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Peace Across Generations — home">
      <picture>
        <source srcset="/brand/pag-logo-400.webp" type="image/webp" />
        <img src="/brand/pag-logo-400.png" alt="Peace Across Generations" width="400" height="140" />
      </picture>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      <span class="visually-hidden">{t('menu')}</span>
    </button>

    <div class="site-menu" id="site-menu">
      <nav aria-label="Main">
        <ul>
          {links.map((l) => (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn--primary nav-cta" href="/take-part/" aria-current={isCurrent('/take-part/') ? 'page' : undefined}>{t('nav.takePart')}</a>
      <button class="lowdata-toggle" type="button" aria-pressed="false" data-lowdata-toggle title={t('lowData.hint')}>
        <span class="switch" aria-hidden="true"></span>
        <span>{t('lowData.label')}: <span data-state>{t('lowData.off')}</span></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* The logo's navy disappears on dark backgrounds, so the header stays
     white in both colour schemes (brief §4.1). */
  .site-header {
    background: #fff; color: #003366; border-bottom: 1px solid #d8e1eb;
    position: sticky; top: 0; z-index: 50;
  }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 72px; flex-wrap: wrap; }
  .brand { display: block; padding: 8px 0; line-height: 0; }
  .brand img { width: 180px; height: auto; }
  @media (min-width: 1100px) { .brand img { width: 200px; } }

  .menu-toggle {
    display: none; background: none; border: 2px solid #003366; color: #003366;
    border-radius: 10px; width: 48px; height: 48px; padding: 0; cursor: pointer;
    place-items: center;
  }
  .menu-toggle :global(svg) { width: 26px; height: 26px; }
  .menu-toggle :global(.i-close) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.i-close) { display: block; }

  .site-menu { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0; padding: 0; }
  nav li { margin: 0; }
  nav a {
    display: block; padding: 0.6rem 0.7rem; border-radius: 8px;
    color: #003366; text-decoration: none; font-family: var(--font-heading); font-weight: 600; font-size: 0.98rem;
  }
  nav a:hover { background: #f5f8fb; color: #0b6cb8; }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: #6baf3f; text-decoration-thickness: 3px; text-underline-offset: 0.4em; }
  .nav-cta { background: #2e7130; color: #fff; }
  .nav-cta:hover { background: #245a26; color: #fff; }

  .lowdata-toggle {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px;
    background: none; border: 0; color: #003366; font: inherit; font-size: 0.85rem; cursor: pointer; padding: 0.25rem;
  }
  .switch { width: 34px; height: 20px; border-radius: 999px; background: #c5d1de; position: relative; flex: none; }
  .switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.15s; }
  .lowdata-toggle[aria-pressed='true'] .switch { background: #2e7130; }
  .lowdata-toggle[aria-pressed='true'] .switch::after { transform: translateX(14px); }
  .site-header :global(:focus-visible) { outline-color: #0b6cb8; }

  /* Small screens: hamburger (only when JavaScript is available;
     without it the menu simply stays open below the logo). */
  @media (max-width: 959px) {
    :global(.js) .menu-toggle { display: grid; }
    .site-menu { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0.5rem; padding-bottom: 1rem; }
    :global(.js) .site-menu:not([data-open]) { display: none; }
    nav ul { flex-direction: column; }
    nav a { padding: 0.8rem 0.5rem; font-size: 1.05rem; border-bottom: 1px solid #eef2f6; border-radius: 0; }
    .nav-cta { width: 100%; }
    .lowdata-toggle { justify-content: flex-start; }
  }
</style>
