---
// Shared body of /this-month and /themes/[slug].
import type { Theme } from '../lib/content';
import { monthName, weeklyAction, publishedStories, formatDate } from '../lib/content';
import PageHead from './PageHead.astro';
import StoryList from './StoryList.astro';
import SafetyNote from './SafetyNote.astro';
import Icon from './Icon.astro';

interface Props { theme: Theme; isCurrent?: boolean }
const { theme, isCurrent = false } = Astro.props;
const d = theme.data;
const action = weeklyAction(theme);
const stories = (await publishedStories()).filter((s) => s.data.theme === theme.id);

const blocks = [
  { key: 'creative', title: 'Youth Creative Peace', text: d.creativePrompt, href: '/programmes/youth-creative-peace/' },
  { key: 'talks', title: 'Peace Talks', text: d.peaceTalk, href: '/programmes/peace-talks/' },
  { key: 'conversations', title: 'Generations in Conversation', text: d.conversationQuestion, href: '/programmes/generations-in-conversation/' },
  { key: 'clubs', title: 'Clubs & circles', text: d.clubsAndCircles, href: '/programmes/peace-clubs-and-circles/' },
].filter((b) => b.text);
---
<PageHead title={d.title} eyebrow={`${isCurrent ? 'This month · ' : ''}${monthName(d.month)}`} lede={d.intro} />

{d.contentWarning && (
  <div class="container"><SafetyNote title="Take care" variant="warning" headingLevel="h2"><p>Some pieces this month talk about loss. Take care while reading or listening.</p></SafetyNote></div>
)}

<section class="section section--tight">
  <div class="container">
    <div class="prompt card">
      <p class="eyebrow">The prompt</p>
      <p class="prompt__text">{d.creativePrompt}</p>
      <div class="btn-row"><a class="btn btn--primary" href="/take-part/submit/">Take part</a></div>
    </div>
  </div>
</section>

{blocks.length > 0 && (
  <section class="section section--surface" aria-labelledby="programmes-month">
    <div class="container">
      <h2 id="programmes-month">What each programme is doing this month</h2>
      <div class="grid grid--2">
        {blocks.map((b) => (
          <div class="card card--tag" data-programme={b.key}>
            <h3><a href={b.href}>{b.title}</a></h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<section class="section">
  <div class="container grid grid--2">
    {d.pauseFocus && (
      <div class="card">
        <span class="icon-badge"><Icon name="search" /></span>
        <h2>Pause Before You Share</h2>
        <p><strong>This month’s focus:</strong> {d.pauseFocus}</p>
        <a class="text-link" href="/pause-before-you-share/">Learn the habit →</a>
      </div>
    )}
    {action && (
      <div class="card">
        <span class="icon-badge"><Icon name="sprout" /></span>
        <h2>Peace Where We Live</h2>
        <p><strong>This weekend:</strong> {action.action}</p>
        {d.weeklyActions.length > 1 && (
          <details>
            <summary>All weekend actions this month</summary>
            <ul>{d.weeklyActions.map((a) => <li><strong>{formatDate(a.weekOf)}:</strong> {a.action}</li>)}</ul>
          </details>
        )}
      </div>
    )}
  </div>
</section>

<section class="section section--surface" aria-labelledby="theme-stories">
  <div class="container">
    <h2 id="theme-stories">Stories from this theme</h2>
    <StoryList stories={stories} />
  </div>
</section>

<style>
  .prompt { border-top: 6px solid var(--color-green); }
  .prompt__text { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem); color: var(--heading); line-height: 1.35; }
  h2 { font-size: 1.35rem; }
  summary { cursor: pointer; color: var(--link); font-weight: 600; }
</style>
