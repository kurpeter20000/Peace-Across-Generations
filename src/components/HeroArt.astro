    <path d="M96 104c10-8 22-8 30 0M156 90c10-6 22-4 28 4M190 128c8-6 18-6 24 2" class="s-leaf" stroke-width="3" />
    <!-- dove -->
    <path d="M250 64c10-18 28-26 46-22-10 4-16 10-18 18 10-4 22-2 30 6-12 0-22 6-28 14-10 2-22-2-30-16z" class="s-sky" stroke-width="3" />
