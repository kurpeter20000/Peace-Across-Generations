</svg>

<style>
  .s-navy { stroke: var(--art-navy, #003366); }
  .s-sky { stroke: #1086e1; }
  .s-green { stroke: var(--art-green, #2e7130); }
  .s-leaf { stroke: #6baf3f; }
  @media (prefers-color-scheme: dark) {
    svg { --art-navy: #5fb0f0; --art-green: #7cc47f; }
  }
</style>
