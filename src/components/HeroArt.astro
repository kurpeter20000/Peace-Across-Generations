    <!-- young person, arms raised -->
    <circle cx="250" cy="182" r="13" class="s-navy" stroke-width="4" />
    <path d="M250 196v48M250 208l-18-22M250 208l18-22M250 244l-11 38M250 244l11 38" class="s-navy" stroke-width="4" />
    <!-- elder with cane -->
    <circle cx="316" cy="196" r="13" class="s-green" stroke-width="4" />
    <path d="M314 210c-4 16-4 32-2 50M312 260l-10 26M312 260l8 26M314 222l18 14M332 236l4 50M332 236c4-4 10-4 12 2" class="s-green" stroke-width="4" />
