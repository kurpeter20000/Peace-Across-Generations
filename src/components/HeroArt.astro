---
// Line-art illustration: a child, a young person and an elder under a
// tree, echoing the three figures in the logo. Decorative.
---
<svg class="hero-art" viewBox="0 0 420 340" aria-hidden="true" focusable="false">
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- rising sun -->
    <circle cx="330" cy="120" r="34" class="s-leaf" stroke-width="3" opacity=".55" />
    <!-- tree -->
    <path d="M130 272c4-40 2-78-6-112M124 190c-14-10-28-14-44-12M126 170c14-12 30-18 50-16" class="s-navy" stroke-width="5" />
