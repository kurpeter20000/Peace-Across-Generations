---
import site from '../data/site.json';
import Email from './Email.astro';
import Icon from './Icon.astro';
import Tbd from './Tbd.astro';
import DayCounter from './DayCounter.astro';
import NewsletterForm from './NewsletterForm.astro';
import { t } from '../i18n';

const explore = [
  ['/about/', 'About'],
  ['/campaigns/', 'Campaigns'],
  ['/stories/', 'Stories & Voices'],
  ['/programmes/', 'Programmes'],
  ['/3000-days/', '3,000 Days for Peace'],
  ['/resources/', 'Resources'],
  ['/blog/', 'Blog'],
  ['/events/', 'Events'],
];
const act = [
  ['/take-action/share-your-voice/', 'Share your voice'],
  ['/take-action/volunteer/', 'Volunteer'],
  ['/take-action/become-a-peace-ambassador/', 'Become a Peace Ambassador'],
  ['/take-action/partner/', 'Partner with us'],
  ['/schools-and-communities/', 'Schools & Communities'],
  ['/standards/', 'Our standards'],
  ['/report-a-concern/', 'Report a concern'],
  ['/privacy/', 'Privacy'],
  ['/contact/', 'Contact'],
];
const socials = Object.entries(site.socials) as [keyof typeof site.socials, string | null][];
const socialLabels = { facebook: 'Facebook', instagram: 'Instagram', youtube: 'YouTube', linkedin: 'LinkedIn', tiktok: 'TikTok', x: 'X' };
const anySocial = socials.some(([, url]) => url);
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-tagline">{site.tagline}</p>
        <p>{site.positioning}</p>
        <p class="footer-day"><DayCounter /></p>
        <h2 class="footer-h">Newsletter</h2>
        <NewsletterForm variant="footer" source="footer" id="newsletter-footer" />
      </div>
      <nav aria-label="Explore">
        <h2 class="footer-h">{t('footer.explore')}</h2>
        <ul class="footer-links">
          {explore.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Take action">
        <h2 class="footer-h">Take action</h2>
        <ul class="footer-links">
          {act.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="footer-h">{t('footer.contact')}</h2>
        <ul class="footer-links">
          <li><Email icon class="footer-icon-link" /></li>
          <li class="footer-icon-link"><Icon name="whatsapp" />
            {site.whatsapp ? <a href={`https://wa.me/${String(site.whatsapp).replace(/\D/g, '')}`} rel="noopener">WhatsApp {String(site.whatsapp).replace(/^\+?(\d{3})(\d{3})(\d{3})(\d{3})$/, '+$1 $2 $3 $4')}</a> : <span>WhatsApp <Tbd>number</Tbd></span>}
          </li>
        </ul>
        <h2 class="footer-h">{t('footer.follow')}</h2>
        {anySocial ? (
          <ul class="footer-social">
            {socials.filter(([, url]) => url).map(([k, url]) => (
              <li><a href={url!} rel="noopener"><Icon name={k} label={socialLabels[k]} /></a></li>
            ))}
          </ul>
        ) : null}

      </div>
    </div>
    <p class="independence">{t('independence')}</p>
    <p class="copyright">{t('copyright')}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--footer-bg); color: var(--footer-text); padding-block: 3rem 2rem; margin-top: 0; }
  .site-footer :global(a) { color: #fff; }
  .site-footer :global(a:hover) { color: #9fd67a; }
  .site-footer :global(:focus-visible) { outline-color: #9fd67a; }
  .footer-grid { display: grid; gap: 2rem; }
  @media (min-width: 700px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; } }
  .footer-tagline { font-family: var(--font-heading); font-weight: 700; font-size: 1.25rem; color: #fff; }
  .footer-day { display: inline-block; background: rgb(255 255 255 / 0.08); border-radius: 999px; padding: 0.3rem 0.9rem; }
  .footer-h { color: #fff; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 0.75rem; }
  .footer-h + ul, .footer-h + p { margin-bottom: 1.5rem; }
  .footer-links { list-style: none; padding: 0; }
  .footer-links li { margin: 0; }
  .footer-links :global(a) { display: inline-block; padding: 0.3rem 0; }
  .footer-icon-link, :global(.footer-icon-link) { display: inline-flex !important; align-items: center; gap: 0.5rem; }
  .footer-links :global(svg) { width: 20px; height: 20px; flex: none; }
  .footer-social { display: flex; gap: 0.75rem; list-style: none; padding: 0; }
  .footer-social li { margin: 0; }
  .footer-social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: rgb(255 255 255 / 0.1); }
  /* One straight line on wide screens; it wraps only where the screen is too narrow. */
  .independence { border-top: 1px solid rgb(255 255 255 / 0.18); padding-top: 1.5rem; margin: 1rem 0 0.75rem; font-size: 0.9rem; max-width: none; text-align: center; }
  @media (min-width: 1200px) { .independence { white-space: nowrap; font-size: 0.85rem; } }
  .copyright { font-size: 0.85rem; opacity: 0.85; margin: 0; max-width: none; text-align: center; }
</style>
