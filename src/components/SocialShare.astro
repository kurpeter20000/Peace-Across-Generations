---
// Plain share links (no third-party scripts). Share text never tags contributors.
import Icon from './Icon.astro';
interface Props { title: string; url: string }
const { title, url } = Astro.props;
---
<section class="share" aria-label="Share">
  <h2>Share</h2>
  <div class="btn-row">
    <a class="btn btn--primary" href={`https://wa.me/?text=${encodeURIComponent(`${title} — ${url}`)}`} rel="noopener" data-track="share:whatsapp"><Icon name="whatsapp" />WhatsApp</a>
    <a class="btn btn--secondary" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} rel="noopener" data-track="share:facebook"><Icon name="facebook" />Facebook</a>
    <a class="btn btn--secondary" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`} rel="noopener" data-track="share:x"><Icon name="x" />X</a>
  </div>
  <p class="copy">Or copy the link: <input type="text" readonly value={url} aria-label="Link to this page" /></p>
</section>

<style>
  h2 { font-size: 1.25rem; }
  .copy input { width: 100%; max-width: 420px; padding: 0.5rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); font: inherit; }
</style>
