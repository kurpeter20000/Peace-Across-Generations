---
// The leaf-between-two-lines divider from the logo.
interface Props { align?: 'center' | 'left' }
const { align = 'center' } = Astro.props;
---
<div class:list={['leaf-divider', { 'leaf-divider--left': align === 'left' }]} aria-hidden="true">
  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M3.5 19.5C4 11 10 4.8 20.5 4.5 20.2 15 14 20.5 5.6 20.9l6.8-8.4-8.9 7z"/></svg>
</div>
