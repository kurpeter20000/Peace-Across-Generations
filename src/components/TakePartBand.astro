---
// Closing call to action on every page (CTASection).
import { currentTheme } from '../lib/content';
import LeafDivider from './LeafDivider.astro';
const theme = await currentTheme();
---
<section class="take-part-band" aria-labelledby="tpb-title">
  <div class="container">
    <LeafDivider />
    <h2 id="tpb-title">Your voice belongs here</h2>
    <p>
      {theme ? <>This month’s campaign is <strong>{theme.data.title}</strong>. </> : null}
      If you have a phone, a pen or a voice, you can take part.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/campaigns/current/" data-track="cta:join-band">Join the conversation</a>
      <a class="btn btn--secondary" href="/take-action/share-your-voice/" data-track="cta:share-band">Share your voice</a>
    </div>
  </div>
</section>

<style>
  .take-part-band { background: var(--surface); border-top: 1px solid var(--line); padding-block: 3rem; text-align: center; }
  .take-part-band p { margin-inline: auto; }
  .take-part-band .btn-row { justify-content: center; }
  h2 { margin-top: 1rem; }
</style>
