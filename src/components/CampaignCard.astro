---
import type { Theme } from '../lib/content';
import { monthName, campaignUrl, approachStages } from '../lib/content';

interface Props { campaign: Theme; current?: boolean; headingLevel?: 'h2' | 'h3' }
const { campaign, current = false, headingLevel: H = 'h3' } = Astro.props;
const d = campaign.data;
const stage = approachStages.find((s) => s.key === d.stage);
const live = !d.draft;
const ended = !current && live && new Date() > d.endDate;
const status = current ? 'Now' : ended ? 'Past' : !live ? 'Coming soon' : undefined;
---
<article class:list={['card campaign-card', { 'card--link': live, current, upcoming: !live }]}>
  <p class="campaign-card__n">{stage?.n ?? '—'}</p>
  <p class="eyebrow">{monthName(d.month)}{stage && <> · {stage.name}</>}</p>
  <H>{live ? <a class="card__link" href={campaignUrl(campaign)}>{d.title}</a> : d.title}</H>
  {live && <p>{d.message ?? d.intro}</p>}
  {status && <span class:list={['chip', 'status', status === 'Now' && 'status--now', status === 'Past' && 'status--past']}>{status}</span>}
</article>

<style>
  h2, h3 { font-size: 1.2rem; }
  h2 a, h3 a { text-decoration: none; color: inherit; }
  .campaign-card { display: flex; flex-direction: column; gap: 0.3rem; }
  .campaign-card:hover a { text-decoration: underline; }
  .campaign-card__n { margin: 0; font-family: var(--font-heading); font-size: 1.9rem; color: var(--color-green); line-height: 1; }
  .current { background: var(--color-green); color: #fff; border-color: var(--color-green); }
  .current .campaign-card__n, .current .eyebrow, .current h2, .current h3, .current p:not(.chip) { color: #fff; }
  .upcoming { box-shadow: none; border-style: dashed; background: transparent; }
  .status { align-self: flex-start; margin-top: 0.3rem; }
  .status--now { background: #fff; color: var(--color-green-dark); }
  .status--past { background: var(--color-sky-light); color: var(--text-muted); }
</style>
