---
// Programmes as one panel: a photo tile, then a column per programme —
// one line of what it is, one line of rhythm, and a clear button. Full
// detail lives on each programme's own page, not stacked here.
import { Picture } from 'astro:assets';
import { photos } from '../data/photos';

const columns = [
  {
    key: 'creative', title: 'Youth Creative Peace', href: '/programmes/youth-creative-peace/',
    line: 'Turn your poem, song, drawing, photo or letter into a public message for peace.',
    tag: 'Letters, poetry, music, art and drama',
  },
  {
    key: 'clubs', title: 'Peace Clubs & Community Circles', href: '/programmes/peace-clubs-and-circles/',
    line: 'A regular, supervised place for young people to practise peace face to face.',
    tag: 'Twice a month, in schools and communities',
  },
  {
    key: 'talks', title: 'Peace Talks', href: '/programmes/peace-talks/',
    line: 'One expert, one live conversation, every month — free.',
    tag: 'Live, then audio and radio',
  },
  {
    key: 'conversations', title: 'Generations in Conversation', href: '/programmes/generations-in-conversation/',
    line: 'Young people ask. Elders answer. Together they decide what to pass on.',
    tag: 'New episodes twice a month',
  },
];
const photo = photos.workshopGroup;
---
<div class="panel">
  <a class="panel__photo" href="/programmes/">
    <span class="ld-hide panel__img" aria-hidden="true">
      <Picture src={photo.src} alt="" widths={[400, 700]} sizes="(min-width: 1100px) 20vw, 100vw" formats={['avif', 'webp']} quality={60} loading="lazy" />
    </span>
    <span class="panel__label">Our<br />Programmes <span aria-hidden="true">→</span></span>
  </a>
  {columns.map((c) => (
    <article class="panel__col" data-programme={c.key}>
      <h3>{c.title}</h3>
      <p>{c.line}</p>
      <p class="panel__tag">{c.tag}</p>
      <a class="btn btn--primary btn--block btn--arrow" href={c.href}>Learn more <span class="visually-hidden">about {c.title}</span></a>
    </article>
  ))}
</div>

<style>
  .panel { display: grid; background: var(--surface); box-shadow: 0 24px 60px rgb(0 51 102 / 0.12); border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 700px) { .panel { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .panel { grid-template-columns: 1.05fr repeat(4, 1fr); } }
  .panel__photo {
    position: relative; min-height: 260px; display: flex; align-items: flex-end; padding: 1.5rem;
    background: linear-gradient(160deg, #0a4a85, #003366); text-decoration: none; isolation: isolate;
  }
  .panel__img { position: absolute; inset: 0; z-index: -2; }
  .panel__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .panel__photo::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(0 51 102 / 0.1) 30%, rgb(0 36 71 / 0.85) 100%); }
  .panel__label { color: #fff; font-family: var(--font-heading); font-weight: 700; font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem); line-height: 1.15; }
  .panel__label span { color: #9fd67a; }
  .panel__photo:hover .panel__label span { margin-left: 0.25rem; }
  .panel__col { display: flex; flex-direction: column; padding: 1.75rem 1.5rem; border-top: 1px solid var(--line); }
  @media (min-width: 1100px) { .panel__col { border-top: 0; border-left: 1px solid var(--line); } }
  .panel__col h3 { font-size: 1.2rem; }
  .panel__col p { font-size: 0.97rem; color: var(--text-muted); }
  .panel__tag {
    margin: 0.75rem 0 1.5rem; padding-top: 0.75rem; border-top: 1px solid var(--line);
    font-family: var(--font-heading); font-weight: 600; font-size: 0.82rem; color: var(--accent-text);
  }
  .panel__col .btn { margin-top: auto; font-size: 0.76rem; padding-inline: 0.75rem; white-space: nowrap; }
</style>
