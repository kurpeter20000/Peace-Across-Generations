---
// Email link obfuscated against scrapers: the address is assembled in the
// browser. Without JavaScript the link goes to /contact and shows the
// address as "name [at] domain".
import site from '../data/site.json';
import Icon from './Icon.astro';

interface Props {
  subject?: string;
  body?: string;
  /** Visible label. When omitted, the email address itself is shown. */
  label?: string;
  class?: string;
  icon?: boolean;
  user?: string;
  domain?: string;
}
const { subject, body, label, class: cls, icon = false, user = site.email.user, domain = site.email.domain } = Astro.props;
const fallbackText = `${user} [at] ${domain.replace('.', ' [dot] ')}`;
---
<a
  href="/contact/"
  class={cls}
  data-eu={user}
  data-ed={domain}
  data-subject={subject}
  data-body={body}
  data-show-address={label ? undefined : ''}
>{icon && <Icon name="mail" />}<span>{label ?? fallbackText}</span></a>
