---
// "Day N of 3,000". Rendered at build time so it is correct without
// JavaScript on the day of the build; site.ts refreshes it in the browser.
import { commitmentDay, fmt } from '../lib/day';
import { t } from '../i18n';

interface Props { variant?: 'inline' | 'large' }
const { variant = 'inline' } = Astro.props;
const s = commitmentDay();
---
{variant === 'inline' ? (
  <span class="day-inline" data-daycounter="inline">
    {s.kind === 'before' ? t('day.before') : s.kind === 'after' ? t('day.after') : `Day ${fmt(s.day)} ${t('day.of')}`}
  </span>
) : (
  <div class="day-large" data-daycounter="large">
    <p class="day-large__num">
      {s.kind === 'during' ? <>Day <strong data-dc-day>{fmt(s.day)}</strong> <span>of 3,000</span></> : s.kind === 'before' ? t('day.before') : t('day.after')}
    </p>
    <svg class="day-large__bar" viewBox="0 0 100 4" preserveAspectRatio="none" role="img" aria-label={s.kind === 'during' ? `${s.percent.toFixed(1)}% of the commitment completed` : ''}>
      <rect width="100" height="4" rx="2" class="track" />
      <rect width={s.kind === 'during' ? Math.max(s.percent, 0.6) : s.kind === 'after' ? 100 : 0} height="4" rx="2" class="fill" data-dc-bar />
    </svg>
    {s.kind === 'during' && <p class="day-large__togo"><strong data-dc-togo>{fmt(s.daysToGo)}</strong> {t('day.toGo')}</p>}
  </div>
)}

<style>
  .day-inline { font-family: var(--font-heading); font-weight: 600; font-size: 0.9rem; }
  .day-large { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); }
  .day-large__num { font-family: var(--font-heading); color: var(--heading); font-size: 1.5rem; font-weight: 600; margin: 0 0 1rem; }
  .day-large__num strong { font-size: clamp(3rem, 2rem + 5vw, 4.5rem); line-height: 1; display: inline-block; }
  .day-large__bar { display: block; width: 100%; height: 14px; }
  .track { fill: var(--line); }
  .fill { fill: var(--color-leaf); }
  .day-large__togo { margin: 0.75rem 0 0; color: var(--text-muted); }
</style>
